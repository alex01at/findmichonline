{% extends 'layout/base.twig' %}

{% block title %}{{ trans('footer.kontakt') }} – findmichonline{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block body %}
    <div class="card">
        <h1>{{ trans('footer.kontakt') }}</h1>

        {% if errors is defined and errors|length > 0 %}
            <ul class="errors">
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        {% endif %}

        <form method="post" action="/kontakt">
            <label for="name">{{ trans('contact.name_label') }}</label>
            <input type="text" id="name" name="name" value="{{ old.name|default('') }}" required>

            <label for="email">{{ trans('contact.email_label') }}</label>
            <input type="email" id="email" name="email" value="{{ old.email|default('') }}" required>

            <label for="message">{{ trans('contact.message_label') }}</label>
            <textarea id="message" name="message" rows="6" required style="width:100%; padding:0.6rem 0.8rem; border:1px solid var(--border); border-radius:8px; font-size:1rem; font-family:inherit;">{{ old.message|default('') }}</textarea>

            <button type="submit">{{ trans('contact.submit') }}</button>
        </form>
    </div>
{% endblock %}
