{% extends 'layout/base.twig' %}

{% block title %}{{ trans('auth.login.heading') }} – Kartenlink{% endblock %}

{% block body %}
    <div class="card">
        <h1>{{ trans('auth.login.heading') }}</h1>

        {% if errors is defined and errors|length > 0 %}
            <ul class="errors">
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        {% endif %}

        <form method="post" action="/login">
            <label for="email">{{ trans('auth.login.email_label') }}</label>
            <input type="email" id="email" name="email" value="{{ old.email|default('') }}" required>

            <label for="password">{{ trans('auth.login.password_label') }}</label>
            <div class="password-field">
                <input type="password" id="password" name="password" required>
                <button type="button" class="password-toggle" data-toggle-for="password" aria-label="{{ trans('auth.password_toggle_show') }}">👁</button>
            </div>

            <label style="display:flex; align-items:center; gap:0.5rem; margin-top:1rem;">
                <input type="checkbox" name="remember" value="1">
                {{ trans('auth.login.remember_me') }}
            </label>

            <button type="submit">{{ trans('auth.login.submit') }}</button>
        </form>
        <a class="muted-link" href="/forgot-password">{{ trans('auth.login.forgot_password') }}</a>
        <a class="muted-link" href="/register">{{ trans('auth.login.no_account') }}</a>
    </div>
{% endblock %}
