{% extends 'layout/base.twig' %}

{% block title %}{{ trans('auth.forgot_password.heading') }} – Kartenlink{% endblock %}

{% block body %}
    <div class="card">
        <h1>{{ trans('auth.forgot_password.heading') }}</h1>
        <p class="muted-link">{{ trans('auth.forgot_password.intro') }}</p>

        <form method="post" action="/forgot-password">
            <label for="email">{{ trans('auth.login.email_label') }}</label>
            <input type="email" id="email" name="email" required>

            <button type="submit">{{ trans('auth.forgot_password.submit') }}</button>
        </form>
        <a class="muted-link" href="/login">{{ trans('auth.login.heading') }}</a>
    </div>
{% endblock %}
