{% extends 'layout/base.twig' %}

{% block title %}{{ trans('admin.legal_heading') }} – findmichonline{% endblock %}
{% block main_class %}wide{% endblock %}

{% block body %}
    <h1>{{ trans('admin.legal_heading') }}</h1>

    <form method="post" action="/admin/legal">
        <div class="card">
            <h2 style="margin-top:0; font-size:1.2rem;">{{ trans('footer.impressum') }}</h2>

            <label for="content_de_impressum">{{ trans('admin.legal_lang_de') }}</label>
            <textarea id="content_de_impressum" name="content_de_impressum" rows="8" style="width:100%; padding:0.6rem 0.8rem; border:1px solid var(--border); border-radius:8px; font-size:0.95rem; font-family:inherit;">{{ pages.impressum.content_de|default('') }}</textarea>

            <label for="content_en_impressum">{{ trans('admin.legal_lang_en') }}</label>
            <textarea id="content_en_impressum" name="content_en_impressum" rows="8" style="width:100%; padding:0.6rem 0.8rem; border:1px solid var(--border); border-radius:8px; font-size:0.95rem; font-family:inherit;">{{ pages.impressum.content_en|default('') }}</textarea>
        </div>

        <div class="card" style="margin-top:1.5rem;">
            <h2 style="margin-top:0; font-size:1.2rem;">{{ trans('footer.datenschutz') }}</h2>

            <label for="content_de_datenschutz">{{ trans('admin.legal_lang_de') }}</label>
            <textarea id="content_de_datenschutz" name="content_de_datenschutz" rows="8" style="width:100%; padding:0.6rem 0.8rem; border:1px solid var(--border); border-radius:8px; font-size:0.95rem; font-family:inherit;">{{ pages.datenschutz.content_de|default('') }}</textarea>

            <label for="content_en_datenschutz">{{ trans('admin.legal_lang_en') }}</label>
            <textarea id="content_en_datenschutz" name="content_en_datenschutz" rows="8" style="width:100%; padding:0.6rem 0.8rem; border:1px solid var(--border); border-radius:8px; font-size:0.95rem; font-family:inherit;">{{ pages.datenschutz.content_en|default('') }}</textarea>
        </div>

        <button type="submit">{{ trans('admin.legal_save') }}</button>
    </form>

    <a class="muted-link" href="/admin" style="display:inline-block; margin-top:1rem;">{{ trans('admin.back_to_list') }}</a>
{% endblock %}
