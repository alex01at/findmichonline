{% extends 'layout/base.twig' %}

{% block title %}{{ target_user.name }} – {{ trans('admin.heading') }}{% endblock %}
{% block main_class %}wide{% endblock %}

{% block body %}
    {% if errors is defined and errors|length > 0 %}
        <ul class="errors">
            {% for error in errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    <div class="card">
        <h1>{{ target_user.name }}</h1>

        <form method="post" action="/admin/users/{{ target_user.id }}">
            <label for="name">{{ trans('auth.register.name_label') }}</label>
            <input type="text" id="name" name="name" value="{{ target_user.name }}" required>

            <label for="email">{{ trans('auth.register.email_label') }}</label>
            <input type="email" id="email" name="email" value="{{ target_user.email }}" required>

            <label for="new_password">{{ trans('admin.new_password_label') }}</label>
            <input type="password" id="new_password" name="new_password" minlength="8" placeholder="{{ trans('admin.new_password_placeholder') }}">

            <label for="plan">{{ trans('admin.table.plan') }}</label>
            <select id="plan" name="plan" style="width:100%; padding:0.6rem 0.8rem; border:1px solid var(--border); border-radius:8px; font-size:1rem;">
                <option value="free" {% if target_user.plan == 'free' %}selected{% endif %}>Free</option>
                <option value="pro" {% if target_user.plan == 'pro' %}selected{% endif %}>Pro</option>
            </select>

            <label style="display:flex; align-items:center; gap:0.5rem; margin-top:1rem;">
                <input type="checkbox" name="is_admin" value="1" {% if target_user.is_admin %}checked{% endif %}>
                {{ trans('admin.table.admin') }}
            </label>

            <button type="submit">{{ trans('admin.save_user') }}</button>
        </form>
    </div>

    <div class="card" style="margin-top:1.5rem;">
        <h1 style="font-size:1.2rem;">{{ trans('admin.card_heading') }}</h1>

        {% if card and card.is_published and card.slug %}
            <p class="muted-link">
                {{ trans('card.edit.published_notice') }}
                <a href="/{{ card.slug }}" target="_blank">/{{ card.slug }}</a>
            </p>
        {% endif %}

        <form method="post" action="/admin/users/{{ target_user.id }}/card">
            <label for="display_name">{{ trans('card.edit.name_label') }}</label>
            <input type="text" id="display_name" name="display_name" value="{{ card.display_name|default('') }}">

            <label for="job_title">{{ trans('card.edit.job_title_label') }}</label>
            <input type="text" id="job_title" name="job_title" value="{{ card.job_title|default('') }}">

            <label for="company">{{ trans('card.edit.company_label') }}</label>
            <input type="text" id="company" name="company" value="{{ card.company|default('') }}">

            <label for="card_email">{{ trans('card.edit.email_label') }}</label>
            <input type="email" id="card_email" name="email" value="{{ card.email|default('') }}">

            <label for="phone">{{ trans('card.edit.phone_label') }}</label>
            <input type="text" id="phone" name="phone" value="{{ card.phone|default('') }}">

            <label for="website">{{ trans('card.edit.website_label') }}</label>
            <input type="text" id="website" name="website" value="{{ card.website|default('') }}">

            <label for="address">{{ trans('card.edit.address_label') }}</label>
            <input type="text" id="address" name="address" value="{{ card.address|default('') }}">

            <label for="bio">{{ trans('card.edit.bio_label') }}</label>
            <input type="text" id="bio" name="bio" value="{{ card.bio|default('') }}">

            <label for="slug">{{ trans('card.edit.slug_label') }}</label>
            <input type="text" id="slug" name="slug" value="{{ card.slug|default('') }}" placeholder="{{ trans('card.edit.slug_placeholder') }}">

            <label>{{ trans('card.edit.design_label') }}</label>
            <div style="display:flex; gap:1rem; margin-top:0.3rem;">
                <label style="display:flex; align-items:center; gap:0.4rem; font-weight:normal; margin-top:0;">
                    <input type="radio" name="design" value="classic" {% if (card.design|default('classic')) == 'classic' %}checked{% endif %}>
                    {{ trans('card.edit.design_classic') }}
                </label>
                <label style="display:flex; align-items:center; gap:0.4rem; font-weight:normal; margin-top:0;">
                    <input type="radio" name="design" value="modern" {% if (card.design|default('classic')) == 'modern' %}checked{% endif %}>
                    {{ trans('card.edit.design_modern') }}
                </label>
            </div>

            <label style="display:flex; align-items:center; gap:0.5rem; margin-top:1rem;">
                <input type="checkbox" name="is_published" value="1" {% if card.is_published|default(false) %}checked{% endif %}>
                {{ trans('card.edit.publish_label') }}
            </label>

            <button type="submit">{{ trans('card.edit.submit') }}</button>
        </form>

        {% if card %}
            <form method="post" action="/admin/users/{{ target_user.id }}/card/delete" style="margin-top:1rem;" onsubmit="return confirm('{{ trans('admin.confirm_delete_card') }}');">
                <button type="submit" style="background:var(--danger);">{{ trans('admin.delete_card') }}</button>
            </form>
        {% endif %}
    </div>

    <a class="muted-link" href="/admin" style="display:inline-block; margin-top:1rem;">{{ trans('admin.back_to_list') }}</a>
{% endblock %}
