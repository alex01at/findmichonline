{% extends 'layout/base.twig' %}

{% block title %}{{ trans('pricing.heading') }} – findmichonline{% endblock %}
{% block meta_description %}{{ trans('pricing.meta_description') }}{% endblock %}
{% block robots %}index, follow{% endblock %}
{% block main_class %}wide{% endblock %}

{% block body %}
    <h1 style="text-align:center;">{{ trans('pricing.heading') }}</h1>
    <p class="muted-link" style="text-align:center;">{{ trans('pricing.subtitle') }}</p>

    <div style="display:flex; gap:1.5rem; margin-top:2rem; flex-wrap:wrap; justify-content:center;">
        <div class="card" style="flex:1; min-width:260px; max-width:320px;">
            <h2 style="margin-top:0;">{{ trans('pricing.free.name') }}</h2>
            <p style="font-size:1.5rem; font-weight:700; margin:0 0 1rem 0;">{{ trans('pricing.free.price') }}</p>
            <ul style="padding-left:1.2rem; line-height:1.9;">
                <li>{{ trans('pricing.feature.card') }}</li>
                <li>{{ trans('pricing.feature.classic_design') }}</li>
                <li>{{ trans('pricing.feature.qr') }}</li>
            </ul>

            {% if current_plan == 'free' %}
                <p class="muted-link">{{ trans('pricing.current_plan') }}</p>
            {% elseif current_plan == 'pro' and not stripe_configured %}
                <form method="post" action="/account/plan">
                    <input type="hidden" name="plan" value="free">
                    <button type="submit">{{ trans('pricing.cta.downgrade') }}</button>
                </form>
            {% endif %}
        </div>

        <div class="card" style="flex:1; min-width:260px; max-width:320px; border-color:var(--primary);">
            <h2 style="margin-top:0;">{{ trans('pricing.pro.name') }}</h2>

            <div style="display:flex; align-items:center; justify-content:center; gap:0.6rem; margin-bottom:0.6rem;">
                <span id="billing-label-monthly" style="font-size:0.9rem; color:var(--muted);">{{ trans('pricing.toggle_monthly') }}</span>
                <label class="switch">
                    <input type="checkbox" id="billing-yearly-toggle" checked>
                    <span class="slider"></span>
                </label>
                <span id="billing-label-yearly" style="font-size:0.9rem; color:var(--text); font-weight:600;">{{ trans('pricing.toggle_yearly') }}</span>
            </div>

            <p style="font-size:1.5rem; font-weight:700; margin:0.6rem 0 0.2rem 0;">
                <span id="billing-price" data-monthly="{{ trans('pricing.pro.price') }}" data-yearly="{{ trans('pricing.pro.price_yearly') }}">{{ trans('pricing.pro.price_yearly') }}</span>
            </p>
            <p id="billing-savings" class="muted-link" style="margin:0 0 1rem 0;">{{ trans('pricing.pro.savings_yearly') }}</p>

            <ul style="padding-left:1.2rem; line-height:1.9;">
                <li>{{ trans('pricing.feature.card') }}</li>
                <li>{{ trans('pricing.feature.classic_design') }}</li>
                <li>{{ trans('pricing.feature.pro_designs') }}</li>
                <li>{{ trans('pricing.feature.custom_colors') }}</li>
                <li>{{ trans('pricing.feature.qr') }}</li>
                <li>{{ trans('pricing.feature.vcard') }}</li>
                <li>{{ trans('pricing.feature.view_stats') }}</li>
                <li>{{ trans('pricing.feature.no_branding') }}</li>
                <li>{{ trans('pricing.feature.gallery') }}</li>
                <li>{{ trans('pricing.feature.offerings') }}</li>
                <li>{{ trans('pricing.feature.booking_link') }}</li>
            </ul>

            {% if trial_days_left is not null %}
                <p class="muted-link" style="color:var(--success); font-weight:600;">{{ trans('pricing.trial_active', {days: trial_days_left}) }}</p>
            {% endif %}
            {% if current_plan == 'pro' %}
                <p class="muted-link">{{ trans('pricing.current_plan') }}</p>
                {% if cancel_at_period_end %}
                    <p class="muted-link">{{ trans('pricing.cancel_scheduled') }}</p>
                {% endif %}
                {% if stripe_configured and has_stripe_customer %}
                    <form method="post" action="/billing/portal">
                        <button type="submit">{{ trans('pricing.cta.manage_subscription') }}</button>
                    </form>
                {% elseif not stripe_configured %}
                    <form method="post" action="/account/plan">
                        <input type="hidden" name="plan" value="free">
                        <button type="submit">{{ trans('pricing.cta.downgrade') }}</button>
                    </form>
                {% endif %}
            {% elseif current_plan == 'free' %}
                {% if stripe_configured %}
                    <form method="post" action="/billing/checkout">
                        <input type="hidden" name="interval" id="checkout-interval" value="yearly">
                        <button type="submit">{{ trans('pricing.cta.upgrade') }}</button>
                    </form>
                {% else %}
                    <form method="post" action="/account/plan">
                        <input type="hidden" name="plan" value="pro">
                        <button type="submit">{{ trans('pricing.cta.upgrade') }}</button>
                    </form>
                {% endif %}
            {% else %}
                <a class="btn" href="/login">{{ trans('pricing.cta.login_required') }}</a>
            {% endif %}
        </div>

        <div class="card" style="flex:1; min-width:260px; max-width:320px;">
            <h2 style="margin-top:0;">{{ trans('pricing.firma.name') }}</h2>
            <p style="font-size:1.5rem; font-weight:700; margin:0.6rem 0 0.2rem 0;">{{ trans('pricing.firma.price') }}</p>
            <p class="muted-link" style="margin:0 0 1rem 0;">{{ trans('pricing.firma.min_note') }}</p>

            <ul style="padding-left:1.2rem; line-height:1.9;">
                <li>{{ trans('pricing.feature.pro_designs') }}</li>
                <li>{{ trans('pricing.feature.custom_colors') }}</li>
                <li>{{ trans('pricing.feature.vcard') }}</li>
                <li>{{ trans('pricing.feature.view_stats') }}</li>
                <li>{{ trans('pricing.feature.no_branding') }}</li>
                <li>{{ trans('pricing.feature.gallery') }}</li>
                <li>{{ trans('pricing.feature.offerings') }}</li>
                <li>{{ trans('pricing.feature.booking_link') }}</li>
                <li>{{ trans('pricing.firma.feature_team') }}</li>
                <li>{{ trans('pricing.firma.feature_admin') }}</li>
            </ul>

            <a class="btn" href="/team">{{ trans('pricing.firma.cta') }}</a>
        </div>
    </div>

    <div class="section-heading" style="margin-top:3.5rem;">
        <h2>{{ trans('pricing.comparison_heading') }}</h2>
    </div>
    <div class="card" style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; font-size:0.92rem;">
            <thead>
                <tr style="text-align:left; border-bottom:1px solid var(--border);">
                    <th style="padding:0.6rem;">{{ trans('pricing.comparison.feature_col') }}</th>
                    <th style="padding:0.6rem; text-align:center;">{{ trans('pricing.free.name') }}</th>
                    <th style="padding:0.6rem; text-align:center;">{{ trans('pricing.pro.name') }}</th>
                    <th style="padding:0.6rem; text-align:center;">{{ trans('pricing.firma.name') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in [
                    {label: 'pricing.feature.card', free: true, pro: true, firma: true},
                    {label: 'pricing.feature.qr', free: true, pro: true, firma: true},
                    {label: 'pricing.feature.classic_design', free: true, pro: true, firma: true},
                    {label: 'pricing.comparison.whatsapp', free: true, pro: true, firma: true},
                    {label: 'pricing.comparison.social_links', free: true, pro: true, firma: true},
                    {label: 'pricing.feature.pro_designs', free: false, pro: true, firma: true},
                    {label: 'pricing.feature.custom_colors', free: false, pro: true, firma: true},
                    {label: 'pricing.feature.vcard', free: false, pro: true, firma: true},
                    {label: 'pricing.feature.view_stats', free: false, pro: true, firma: true},
                    {label: 'pricing.feature.no_branding', free: false, pro: true, firma: true},
                    {label: 'pricing.feature.gallery', free: false, pro: true, firma: true},
                    {label: 'pricing.feature.offerings', free: false, pro: true, firma: true},
                    {label: 'pricing.feature.booking_link', free: false, pro: true, firma: true},
                    {label: 'pricing.comparison.exclusive_palettes', free: false, pro: false, firma: true},
                    {label: 'pricing.comparison.team_management', free: false, pro: false, firma: true},
                    {label: 'pricing.comparison.shared_branding', free: false, pro: false, firma: true},
                ] %}
                    <tr style="border-bottom:1px solid var(--border);">
                        <td style="padding:0.6rem;">{{ trans(row.label) }}</td>
                        <td style="padding:0.6rem; text-align:center;">{% if row.free %}<span style="color:var(--success); font-weight:700;">✓</span>{% else %}<span class="muted-link" style="margin:0;">–</span>{% endif %}</td>
                        <td style="padding:0.6rem; text-align:center;">{% if row.pro %}<span style="color:var(--success); font-weight:700;">✓</span>{% else %}<span class="muted-link" style="margin:0;">–</span>{% endif %}</td>
                        <td style="padding:0.6rem; text-align:center;">{% if row.firma %}<span style="color:var(--success); font-weight:700;">✓</span>{% else %}<span class="muted-link" style="margin:0;">–</span>{% endif %}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <p class="muted-link" style="text-align:center; margin-top:2rem;">
        {{ stripe_configured ? trans('pricing.note_stripe') : trans('pricing.note_dev_mode') }}
    </p>

    <script>
        (function () {
            var toggle = document.getElementById('billing-yearly-toggle');
            var labelMonthly = document.getElementById('billing-label-monthly');
            var labelYearly = document.getElementById('billing-label-yearly');
            var price = document.getElementById('billing-price');
            var savings = document.getElementById('billing-savings');
            var checkoutInterval = document.getElementById('checkout-interval');
            if (!toggle) return;

            function render() {
                var yearly = toggle.checked;
                price.textContent = yearly ? price.dataset.yearly : price.dataset.monthly;
                savings.hidden = !yearly;
                labelMonthly.style.color = yearly ? 'var(--muted)' : 'var(--text)';
                labelMonthly.style.fontWeight = yearly ? 'normal' : '600';
                labelYearly.style.color = yearly ? 'var(--text)' : 'var(--muted)';
                labelYearly.style.fontWeight = yearly ? '600' : 'normal';
                if (checkoutInterval) checkoutInterval.value = yearly ? 'yearly' : 'monthly';
            }

            toggle.addEventListener('change', render);
            render();
        })();
    </script>
{% endblock %}
