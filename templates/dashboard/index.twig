{% extends 'layout/base.twig' %}

{% block title %}Dashboard – findmichonline{% endblock %}
{% block main_class %}wide{% endblock %}

{% block body %}
    <div class="card">
        <h1>{{ trans('dashboard.welcome', {name: user.name}) }}</h1>
        <p>{{ trans('dashboard.email_label', {email: user.email}) }}</p>
        <p>
            {{ trans('dashboard.plan_label', {plan: trans(user.plan == 'pro' ? 'dashboard.plan_pro' : 'dashboard.plan_free')}) }}
            &middot; <a href="/pricing">{{ trans('dashboard.view_pricing') }}</a>
        </p>

        {% if card %}
            <p>
                {{ trans('dashboard.status_label') }}
                {% if card.is_published %}
                    {{ trans('dashboard.status_published') }} <a href="/{{ card.slug }}" target="_blank">/{{ card.slug }}</a>
                {% else %}
                    {{ trans('dashboard.status_unpublished') }}
                {% endif %}
            </p>
            <a class="btn" href="/card/edit">{{ trans('dashboard.edit_card') }}</a>
        {% else %}
            <p>{{ trans('dashboard.no_card') }}</p>
            <a class="btn" href="/card/edit">{{ trans('dashboard.create_card') }}</a>
        {% endif %}
    </div>

    {% if card %}
        <div class="card" style="margin-top:1.5rem;">
            <h1 style="font-size:1.2rem;">{{ trans('dashboard.stats_heading') }}</h1>
            {% if can_view_stats %}
                <p style="font-size:2.2rem; font-weight:700; margin:0.3rem 0 0 0;">{{ card.view_count }}</p>
                <p class="muted-link" style="margin-top:0.1rem;">{{ trans('dashboard.stats_views_label') }}</p>
            {% else %}
                <p class="muted-link" style="margin-top:0.5rem;">
                    {{ trans('dashboard.stats_locked_text') }} → <a href="/pricing">{{ trans('dashboard.stats_locked_cta') }}</a>
                </p>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
