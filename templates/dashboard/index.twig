{% extends 'layout/base.twig' %}

{% block title %}Dashboard – findmichonline{% endblock %}
{% block main_class %}wide{% endblock %}

{% block body %}
    {% if demo_minutes_left is not null %}
        <div class="flash success" style="display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap;">
            <span>{{ trans('dashboard.demo_banner', {minutes: demo_minutes_left}) }}</span>
            <a href="/register" style="font-weight:600;">{{ trans('demo.register_cta') }}</a>
        </div>
    {% elseif trial_days_left is not null %}
        <div class="flash success" style="display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap;">
            <span>{{ trans('dashboard.trial_banner', {days: trial_days_left}) }}</span>
            <a href="/pricing" style="font-weight:600;">{{ trans('dashboard.view_pricing') }}</a>
        </div>
    {% endif %}

    {% set plan_key = user.is_demo ? 'dashboard.plan_demo' : (in_organization ? 'dashboard.plan_firma' : (user.plan == 'pro' ? 'dashboard.plan_pro' : (trial_days_left is not null ? 'dashboard.plan_trial' : 'dashboard.plan_free'))) %}
    {% set plan_badge_class = user.is_demo ? 'plan-badge-demo' : (in_organization ? 'plan-badge-firma' : ((user.plan == 'pro' or trial_days_left is not null) ? 'plan-badge-pro' : '')) %}

    <div class="card">
        <div class="dashboard-header">
            <div class="dashboard-header-identity">
                {% if card.photo_path %}
                    <img class="dashboard-avatar" src="/{{ card.photo_path }}" alt="">
                {% else %}
                    <div class="dashboard-avatar">{{ user.name|first|upper }}</div>
                {% endif %}
                <div>
                    <h1>{{ trans('dashboard.welcome', {name: user.name}) }}</h1>
                    <p class="muted-link">{{ trans('dashboard.email_label', {email: user.email}) }}</p>
                </div>
            </div>
            <div class="dashboard-header-actions">
                <span class="plan-badge {{ plan_badge_class }}" {% if user.is_demo %}title="{{ trans('dashboard.plan_demo_hint') }}"{% endif %}>{{ trans(plan_key) }}</span>
                <div class="dashboard-menu">
                    <button type="button" class="dashboard-menu-toggle" id="dashboard-menu-toggle" aria-haspopup="true" aria-expanded="false" aria-label="{{ trans('dashboard.more_actions') }}">⋮</button>
                    <div class="dashboard-menu-panel" id="dashboard-menu-panel" hidden>
                        <a href="/pricing">{{ trans('dashboard.view_pricing') }}</a>
                        {% if in_organization %}
                            <a href="/team">{{ trans('dashboard.view_team') }}</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <p style="margin-top:1.2rem;">
            {{ trans('dashboard.status_label') }}
            {% if card.is_published %}
                {{ trans('dashboard.status_published') }}
                <span class="status-link-row">
                    <a class="status-link" href="{{ app_url }}/{{ card.slug }}" target="_blank">{{ (app_url ~ '/' ~ card.slug)|replace({'https://': '', 'http://': ''}) }}</a>
                    <button type="button" class="copy-btn" data-copy-text="{{ app_url }}/{{ card.slug }}" data-copy-success="✓" aria-label="{{ trans('dashboard.copy_link') }}" title="{{ trans('dashboard.copy_link') }}">📋</button>
                </span>
            {% else %}
                {{ trans('dashboard.status_unpublished') }}
            {% endif %}
        </p>

        <div class="quick-actions">
            <a class="btn" href="/card/edit">{{ trans('dashboard.edit_card') }}</a>
            {% if card.is_published %}
                <a class="btn btn-secondary" href="/{{ card.slug }}" target="_blank">{{ trans('dashboard.view_card') }}</a>
            {% endif %}
            <a class="btn btn-secondary" href="/card/qr.png" target="_blank">{{ trans('dashboard.view_qr') }}</a>
        </div>
    </div>

    <div class="dashboard-layout">
        <div class="dashboard-preview-col">
            <div class="phone-mockup">
                <div class="phone-mockup-frame">
                    <iframe src="/card/preview" loading="lazy" title="{{ trans('dashboard.preview_label') }}"></iframe>
                </div>
            </div>
            <p class="phone-mockup-label">{{ trans('dashboard.preview_label') }}</p>
        </div>

        <div class="dashboard-stats-col">
            <div class="card">
                <h2 style="font-size:1.1rem; margin-top:0;">{{ trans('dashboard.stats_heading') }}</h2>
                {% if can_view_stats %}
                    <div class="stat-tile-grid">
                        <div class="stat-tile stat-tile-primary">
                            <span class="stat-value">{{ card.view_count }}</span>
                            <span class="stat-label">{{ trans('dashboard.stats_views_label') }}</span>
                        </div>
                        {% if card.phone %}
                            <div class="stat-tile"><span class="stat-value">{{ card.clicks_phone }}</span><span class="stat-label">📞 {{ trans('dashboard.stats_calls_label') }}</span></div>
                        {% endif %}
                        {% if card.email %}
                            <div class="stat-tile"><span class="stat-value">{{ card.clicks_email }}</span><span class="stat-label">✉️ {{ trans('dashboard.stats_email_label') }}</span></div>
                        {% endif %}
                        {% if card.website %}
                            <div class="stat-tile"><span class="stat-value">{{ card.clicks_website }}</span><span class="stat-label">🌐 {{ trans('dashboard.stats_website_label') }}</span></div>
                        {% endif %}
                        {% if card.address %}
                            <div class="stat-tile"><span class="stat-value">{{ card.clicks_address }}</span><span class="stat-label">📍 {{ trans('dashboard.stats_address_label') }}</span></div>
                        {% endif %}
                        {% if card.linkedin_url %}
                            <div class="stat-tile"><span class="stat-value">{{ card.clicks_linkedin }}</span><span class="stat-label">LinkedIn</span></div>
                        {% endif %}
                        {% if card.instagram_url %}
                            <div class="stat-tile"><span class="stat-value">{{ card.clicks_instagram }}</span><span class="stat-label">Instagram</span></div>
                        {% endif %}
                        {% if card.facebook_url %}
                            <div class="stat-tile"><span class="stat-value">{{ card.clicks_facebook }}</span><span class="stat-label">Facebook</span></div>
                        {% endif %}
                        {% if card.youtube_url %}
                            <div class="stat-tile"><span class="stat-value">{{ card.clicks_youtube }}</span><span class="stat-label">YouTube</span></div>
                        {% endif %}
                        {% if card.booking_url %}
                            <div class="stat-tile"><span class="stat-value">{{ card.clicks_booking }}</span><span class="stat-label">📅 {{ trans('dashboard.stats_booking_label') }}</span></div>
                        {% endif %}
                    </div>
                {% else %}
                    <p class="muted-link" style="margin-top:0.5rem;">
                        {{ trans('dashboard.stats_locked_text') }} → <a href="/pricing">{{ trans('dashboard.stats_locked_cta') }}</a>
                    </p>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
