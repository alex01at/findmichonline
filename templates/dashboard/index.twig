{% extends 'layout/base.twig' %}

{% block title %}Dashboard – findmichonline{% endblock %}
{% block main_class %}wide{% endblock %}

{% block body %}
    {% if trial_days_left is not null %}
        <div class="flash success" style="display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap;">
            <span>{{ trans('dashboard.trial_banner', {days: trial_days_left}) }}</span>
            <a href="/pricing" style="font-weight:600;">{{ trans('dashboard.view_pricing') }}</a>
        </div>
    {% endif %}

    <div class="card">
        <h1>{{ trans('dashboard.welcome', {name: user.name}) }}</h1>
        <p>{{ trans('dashboard.email_label', {email: user.email}) }}</p>
        <p>
            {{ trans('dashboard.plan_label', {plan: trans(in_organization ? 'dashboard.plan_firma' : (user.plan == 'pro' ? 'dashboard.plan_pro' : (trial_days_left is not null ? 'dashboard.plan_trial' : 'dashboard.plan_free')))}) }}
            &middot; <a href="/pricing">{{ trans('dashboard.view_pricing') }}</a>
            {% if in_organization %}&middot; <a href="/team">{{ trans('dashboard.view_team') }}</a>{% endif %}
        </p>

        {% if card %}
            <p>
                {{ trans('dashboard.status_label') }}
                {% if card.is_published %}
                    {{ trans('dashboard.status_published') }} <a href="/{{ card.slug }}" target="_blank">/{{ card.slug }}</a>
                {% else %}
                    {{ trans('dashboard.status_unpublished') }}
                {% endif %}
            </p>
            <a class="btn" href="/card/edit">{{ trans('dashboard.edit_card') }}</a>
        {% else %}
            <p>{{ trans('dashboard.no_card') }}</p>
            <a class="btn" href="/card/edit">{{ trans('dashboard.create_card') }}</a>
        {% endif %}
    </div>

    {% if card %}
        <div class="card" style="margin-top:1.5rem;">
            <h1 style="font-size:1.2rem;">{{ trans('dashboard.stats_heading') }}</h1>
            {% if can_view_stats %}
                <p style="font-size:2.2rem; font-weight:700; margin:0.3rem 0 0 0;">{{ card.view_count }}</p>
                <p class="muted-link" style="margin-top:0.1rem;">{{ trans('dashboard.stats_views_label') }}</p>

                <p style="font-weight:600; margin-top:1.5rem;">{{ trans('dashboard.stats_clicks_heading') }}</p>
                <table style="width:100%; border-collapse:collapse; font-size:0.92rem;">
                    <tbody>
                        {% if card.phone %}
                            <tr style="border-top:1px solid var(--border);"><td style="padding:0.5rem 0;">📞 {{ trans('card.public.call') }}</td><td style="padding:0.5rem 0; text-align:right; font-weight:600;">{{ card.clicks_phone }}</td></tr>
                        {% endif %}
                        {% if card.email %}
                            <tr style="border-top:1px solid var(--border);"><td style="padding:0.5rem 0;">✉️ {{ trans('card.public.email_action') }}</td><td style="padding:0.5rem 0; text-align:right; font-weight:600;">{{ card.clicks_email }}</td></tr>
                        {% endif %}
                        {% if card.website %}
                            <tr style="border-top:1px solid var(--border);"><td style="padding:0.5rem 0;">🌐 {{ trans('card.public.website_action') }}</td><td style="padding:0.5rem 0; text-align:right; font-weight:600;">{{ card.clicks_website }}</td></tr>
                        {% endif %}
                        {% if card.address %}
                            <tr style="border-top:1px solid var(--border);"><td style="padding:0.5rem 0;">📍 {{ trans('card.public.route') }}</td><td style="padding:0.5rem 0; text-align:right; font-weight:600;">{{ card.clicks_address }}</td></tr>
                        {% endif %}
                        {% if card.linkedin_url %}
                            <tr style="border-top:1px solid var(--border);"><td style="padding:0.5rem 0;">LinkedIn</td><td style="padding:0.5rem 0; text-align:right; font-weight:600;">{{ card.clicks_linkedin }}</td></tr>
                        {% endif %}
                        {% if card.instagram_url %}
                            <tr style="border-top:1px solid var(--border);"><td style="padding:0.5rem 0;">Instagram</td><td style="padding:0.5rem 0; text-align:right; font-weight:600;">{{ card.clicks_instagram }}</td></tr>
                        {% endif %}
                        {% if card.facebook_url %}
                            <tr style="border-top:1px solid var(--border);"><td style="padding:0.5rem 0;">Facebook</td><td style="padding:0.5rem 0; text-align:right; font-weight:600;">{{ card.clicks_facebook }}</td></tr>
                        {% endif %}
                        {% if card.youtube_url %}
                            <tr style="border-top:1px solid var(--border);"><td style="padding:0.5rem 0;">YouTube</td><td style="padding:0.5rem 0; text-align:right; font-weight:600;">{{ card.clicks_youtube }}</td></tr>
                        {% endif %}
                        {% if card.booking_url %}
                            <tr style="border-top:1px solid var(--border);"><td style="padding:0.5rem 0;">📅 {{ trans('card.public.booking_button') }}</td><td style="padding:0.5rem 0; text-align:right; font-weight:600;">{{ card.clicks_booking }}</td></tr>
                        {% endif %}
                    </tbody>
                </table>
            {% else %}
                <p class="muted-link" style="margin-top:0.5rem;">
                    {{ trans('dashboard.stats_locked_text') }} → <a href="/pricing">{{ trans('dashboard.stats_locked_cta') }}</a>
                </p>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
