{% extends 'layout/base.twig' %}

{% block title %}Dashboard – Kartenlink{% endblock %}
{% block main_class %}wide{% endblock %}

{% block body %}
    <div class="card">
        <h1>{{ trans('dashboard.welcome', {name: user.name}) }}</h1>
        <p>{{ trans('dashboard.email_label', {email: user.email}) }}</p>
        <p>
            {{ trans('dashboard.plan_label', {plan: trans(user.plan == 'pro' ? 'dashboard.plan_pro' : 'dashboard.plan_free')}) }}
            &middot; <a href="/pricing">{{ trans('dashboard.view_pricing') }}</a>
        </p>

        {% if card %}
            <p>
                {{ trans('dashboard.status_label') }}
                {% if card.is_published %}
                    {{ trans('dashboard.status_published') }} <a href="/c/{{ card.slug }}" target="_blank">/c/{{ card.slug }}</a>
                {% else %}
                    {{ trans('dashboard.status_unpublished') }}
                {% endif %}
            </p>
            <a class="btn" href="/card/edit">{{ trans('dashboard.edit_card') }}</a>
        {% else %}
            <p>{{ trans('dashboard.no_card') }}</p>
            <a class="btn" href="/card/edit">{{ trans('dashboard.create_card') }}</a>
        {% endif %}
    </div>
{% endblock %}
