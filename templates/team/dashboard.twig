{% extends 'layout/base.twig' %}

{% block title %}{{ organization.name }} – findmichonline{% endblock %}
{% block main_class %}wide{% endblock %}

{% block body %}
    {% if trial_days_left is not null %}
        <div class="flash success" style="display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap;">
            <span>{{ trans('team.dashboard.trial_banner', {days: trial_days_left}) }}</span>
        </div>
    {% endif %}

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:1rem;">
        <h1 style="margin:0;">{{ organization.name }}</h1>
    </div>

    <div class="card">
        <h2 style="margin-top:0;">{{ trans('team.dashboard.billing_heading') }}</h2>
        <p>{{ trans('team.dashboard.seats_label', {seats: organization.seats, min: min_seats}) }}</p>
        <p>{{ trans('team.dashboard.price_label', {price: (organization.seats * 0.49)|number_format(2, ',', '.')}) }}</p>

        {% if organization.subscription_status == 'active' %}
            <p class="muted-link" style="color:var(--success); font-weight:600;">{{ trans('team.dashboard.status_active') }}</p>
            {% if organization.cancel_at_period_end %}
                <p class="muted-link">{{ trans('pricing.cancel_scheduled') }}</p>
            {% endif %}
            {% if stripe_configured %}
                <form method="post" action="/team/portal">
                    <button type="submit">{{ trans('pricing.cta.manage_subscription') }}</button>
                </form>
            {% endif %}
        {% elseif stripe_configured %}
            <form method="post" action="/team/checkout">
                <button type="submit">{{ trans('team.dashboard.checkout_cta') }}</button>
            </form>
        {% else %}
            <p class="muted-link">{{ trans('pricing.note_dev_mode') }}</p>
            <form method="post" action="/team/dev-activate">
                <button type="submit">{{ trans('team.dashboard.dev_activate_cta') }}</button>
            </form>
        {% endif %}
    </div>

    <div class="card">
        <h2 style="margin-top:0;">{{ trans('team.branding.heading') }}</h2>
        <p class="muted-link">{{ trans('team.branding.text') }}</p>

        <form method="post" action="/team/branding" enctype="multipart/form-data">
            <label>{{ trans('team.branding.logo_label') }}</label>
            {% if organization.logo_path %}
                <div style="margin-bottom:0.5rem;">
                    <img src="/{{ organization.logo_path }}" alt="" style="max-height:80px; border-radius:8px;">
                </div>
                <label style="display:flex; align-items:center; gap:0.5rem; font-weight:normal; margin-top:0;">
                    <input type="checkbox" name="remove_logo" value="1">
                    {{ trans('card.edit.logo_remove') }}
                </label>
            {% endif %}
            <input type="file" name="logo" accept="image/png,image/jpeg,image/webp">

            <label style="margin-top:1.5rem;">{{ trans('team.branding.address_label') }}</label>
            {% if organization.address %}
                <p class="muted-link">{{ trans('onboarding.step4.current_label') }} {{ organization.address }}</p>
            {% endif %}
            <input type="text" name="street" placeholder="{{ trans('onboarding.step4.street_label') }}">
            <input type="text" name="postal_code" placeholder="{{ trans('onboarding.step4.postal_code_label') }}" style="margin-top:0.6rem;">
            <input type="text" name="city" placeholder="{{ trans('onboarding.step4.city_label') }}" style="margin-top:0.6rem;">
            <input type="text" name="country" placeholder="{{ trans('onboarding.step4.country_label') }}" style="margin-top:0.6rem;">

            <label style="margin-top:1.5rem;">{{ trans('team.branding.design_label') }}</label>
            <div class="onboarding-design-grid">
                {% for design in ['classic', 'modern', 'professional', 'playful'] %}
                    <label class="onboarding-design-option {% if (organization.design|default('classic')) == design %}active{% endif %}" data-design="{{ design }}">
                        <input type="radio" name="design" value="{{ design }}" {% if (organization.design|default('classic')) == design %}checked{% endif %} style="position:absolute; opacity:0; pointer-events:none;">
                        <div class="onboarding-design-thumb-wrap">
                            <iframe class="branding-preview-frame" src="/card/preview?design={{ design }}&palette={{ organization.color_preset|default('') }}" tabindex="-1"></iframe>
                            <div class="onboarding-design-thumb-overlay"></div>
                        </div>
                        <div class="onboarding-design-label">{{ trans('card.edit.design_' ~ design) }}</div>
                    </label>
                {% endfor %}
            </div>

            <label style="margin-top:1.5rem;">{{ trans('team.branding.palette_label') }}</label>
            <p class="muted-link">{{ trans('team.branding.palette_hint') }}</p>
            <div class="onboarding-design-grid">
                <label class="onboarding-design-option {% if not organization.color_preset %}active{% endif %}" data-palette="">
                    <input type="radio" name="color_preset" value="" {% if not organization.color_preset %}checked{% endif %} style="position:absolute; opacity:0; pointer-events:none;">
                    <div class="onboarding-design-thumb-wrap">
                        <iframe class="branding-preview-frame" src="/card/preview?design={{ organization.design|default('classic') }}&palette=" tabindex="-1"></iframe>
                        <div class="onboarding-design-thumb-overlay"></div>
                    </div>
                    <div class="onboarding-design-label">{{ trans('team.branding.palette_default') }}</div>
                </label>
                {% for key, preset in color_presets %}
                    <label class="onboarding-design-option {% if organization.color_preset == key %}active{% endif %}" data-palette="{{ key }}">
                        <input type="radio" name="color_preset" value="{{ key }}" {% if organization.color_preset == key %}checked{% endif %} style="position:absolute; opacity:0; pointer-events:none;">
                        <div class="onboarding-design-thumb-wrap">
                            <iframe class="branding-preview-frame" src="/card/preview?design={{ organization.design|default('classic') }}&palette={{ key }}" tabindex="-1"></iframe>
                            <div class="onboarding-design-thumb-overlay"></div>
                        </div>
                        <div class="onboarding-design-label">{{ trans('team.branding.palette.' ~ key) }} <span class="onboarding-design-lock">{{ trans('home.badge_firma') }}</span></div>
                    </label>
                {% endfor %}
            </div>

            <button type="submit" style="margin-top:1.5rem;">{{ trans('team.branding.submit') }}</button>
        </form>
    </div>

    <div class="card" style="overflow-x:auto;">
        <h2 style="margin-top:0;">{{ trans('team.dashboard.members_heading') }}</h2>
        <table style="width:100%; border-collapse:collapse; font-size:0.92rem;">
            <thead>
                <tr style="text-align:left; border-bottom:1px solid var(--border);">
                    <th style="padding:0.5rem;">{{ trans('team.dashboard.table.name') }}</th>
                    <th style="padding:0.5rem;">{{ trans('team.dashboard.table.email') }}</th>
                    <th style="padding:0.5rem;">{{ trans('team.dashboard.table.status') }}</th>
                    <th style="padding:0.5rem;"></th>
                </tr>
            </thead>
            <tbody>
                {% for member in members %}
                    <tr style="border-bottom:1px solid var(--border);">
                        <td style="padding:0.5rem;">
                            {{ member.name }}
                            {% if member.id == organization.owner_user_id %}
                                <span class="muted-link">({{ trans('team.dashboard.owner_badge') }})</span>
                            {% endif %}
                        </td>
                        <td style="padding:0.5rem;">{{ member.email }}</td>
                        <td style="padding:0.5rem;">
                            {% if member.id != organization.owner_user_id %}
                                {% if member.onboarding_completed_at is null %}
                                    <span class="muted-link">{{ trans('team.dashboard.status_pending') }}</span>
                                {% else %}
                                    {{ trans('team.dashboard.status_active') }}
                                {% endif %}
                            {% endif %}
                        </td>
                        <td style="padding:0.5rem; white-space:nowrap;">
                            {% if member.onboarding_completed_at is null and member.id != organization.owner_user_id %}
                                <form method="post" action="/team/reinvite/{{ member.id }}" style="display:inline;">
                                    <button type="submit" style="margin:0 0.4rem 0 0; padding:0.2rem 0.6rem; font-size:0.85rem;">{{ trans('team.dashboard.reinvite_button') }}</button>
                                </form>
                            {% endif %}
                            {% if member.id != organization.owner_user_id %}
                                <form method="post" action="/team/remove/{{ member.id }}" style="display:inline;" onsubmit="return confirm('{{ trans('team.dashboard.confirm_remove') }}');">
                                    <button type="submit" style="margin:0; padding:0.2rem 0.6rem; background:var(--danger); font-size:0.85rem;">{{ trans('team.dashboard.remove_button') }}</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="card">
        <h2 style="margin-top:0;">{{ trans('team.dashboard.invite_heading') }}</h2>
        <p class="muted-link">{{ trans('team.dashboard.invite_text') }}</p>
        <form method="post" action="/team/invite">
            <label for="invite_email">{{ trans('team.dashboard.invite_email_label') }}</label>
            <input type="email" id="invite_email" name="email" required>

            <label for="invite_name">{{ trans('team.dashboard.invite_name_label') }}</label>
            <input type="text" id="invite_name" name="name" maxlength="255">

            <label for="invite_job_title">{{ trans('team.dashboard.invite_job_title_label') }}</label>
            <input type="text" id="invite_job_title" name="job_title" maxlength="255">

            <label for="invite_phone">{{ trans('team.dashboard.invite_phone_label') }}</label>
            <input type="text" id="invite_phone" name="phone" maxlength="60">

            <button type="submit">{{ trans('team.dashboard.invite_submit') }}</button>
        </form>
    </div>

    <div class="card">
        <h2 style="margin-top:0;">{{ trans('team.csv_import.heading') }}</h2>
        <p class="muted-link">{{ trans('team.csv_import.text') }}</p>
        <form method="post" action="/team/invite-csv" enctype="multipart/form-data">
            <label for="csv">{{ trans('team.csv_import.file_label') }}</label>
            <input type="file" id="csv" name="csv" accept=".csv,text/csv" required>

            <button type="submit">{{ trans('team.csv_import.submit') }}</button>
        </form>
    </div>
{% endblock %}

{% block extra_scripts %}
<script src="/assets/onboarding.js?v=2" defer></script>
{% endblock %}
