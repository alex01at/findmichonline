{% extends 'layout/base.twig' %}

{% block title %}findmichonline – Digitale Visitenkarte mit QR-Code & eigenem Link{% endblock %}
{% block meta_description %}{{ trans('home.meta_description') }}{% endblock %}
{% block robots %}index, follow{% endblock %}
{% block main_class %}landing{% endblock %}

{% block body %}
    <div class="hero">
        <span class="eyebrow">{{ trans('home.hero_eyebrow') }}</span>
        <h1>{{ trans('home.heading') }}</h1>
        <p>{{ trans('home.subtitle') }}</p>
        <div class="cta-row">
            <a class="btn btn-light" href="/register">{{ trans('home.cta_start') }}</a>
            <a class="cta-secondary" href="/login">{{ trans('home.cta_login') }}</a>
        </div>
        <p class="hero-note">{{ trans('home.hero_note') }}</p>
    </div>

    <div class="section-heading">
        <h2>{{ trans('home.designs_heading') }}</h2>
        <p>{{ trans('home.designs_subtitle') }}</p>
    </div>

    <div class="design-tabs" id="design-showcase-tabs">
        {% for design in ['classic', 'modern', 'professional', 'playful'] %}
            <button type="button" class="design-tab-btn {% if loop.first %}active{% endif %}" data-design="{{ design }}">{{ trans('card.edit.design_' ~ design) }}</button>
        {% endfor %}
    </div>
    <div class="phone-mockup-row">
        <div class="phone-mockup">
            <div class="phone-mockup-frame">
                <iframe id="design-showcase-frame" src="/demo-card/classic" loading="lazy" title="{{ trans('home.designs_heading') }}"></iframe>
            </div>
        </div>
    </div>

    <div class="section-heading" style="margin-top:3.5rem;">
        <h2>{{ trans('home.features_heading') }}</h2>
        <p>{{ trans('home.features_subtitle') }}</p>
    </div>

    <div class="feature-grid">
        <div class="feature-card">
            <span class="icon">🔗</span>
            <h3>{{ trans('home.feature.link_title') }}</h3>
            <p>{{ trans('home.feature.link_text') }}</p>
        </div>
        <div class="feature-card">
            <span class="icon">🎨</span>
            <h3>{{ trans('home.feature.design_title') }}</h3>
            <p>{{ trans('home.feature.design_text') }}</p>
        </div>
        <div class="feature-card">
            <span class="icon">💾</span>
            <h3>{{ trans('home.feature.vcard_title') }}<span class="badge-pro">{{ trans('home.badge_pro') }}</span></h3>
            <p>{{ trans('home.feature.vcard_text') }}</p>
        </div>
        <div class="feature-card">
            <span class="icon">📊</span>
            <h3>{{ trans('home.feature.stats_title') }}<span class="badge-pro">{{ trans('home.badge_pro') }}</span></h3>
            <p>{{ trans('home.feature.stats_text') }}</p>
        </div>
        <div class="feature-card">
            <span class="icon">🖼️</span>
            <h3>{{ trans('home.feature.profile_title') }}</h3>
            <p>{{ trans('home.feature.profile_text') }}</p>
        </div>
        <div class="feature-card">
            <span class="icon">📱</span>
            <h3>{{ trans('home.feature.social_title') }}</h3>
            <p>{{ trans('home.feature.social_text') }}</p>
        </div>
        <div class="feature-card">
            <span class="icon">🌍</span>
            <h3>{{ trans('home.feature.lang_title') }}</h3>
            <p>{{ trans('home.feature.lang_text') }}</p>
        </div>
        <div class="feature-card">
            <span class="icon">⚡</span>
            <h3>{{ trans('home.feature.fast_title') }}</h3>
            <p>{{ trans('home.feature.fast_text') }}</p>
        </div>
        <div class="feature-card">
            <span class="icon">🖼️</span>
            <h3>{{ trans('home.feature.gallery_title') }}<span class="badge-pro">{{ trans('home.badge_pro') }}</span></h3>
            <p>{{ trans('home.feature.gallery_text') }}</p>
        </div>
        <div class="feature-card">
            <span class="icon">🛍️</span>
            <h3>{{ trans('home.feature.offerings_title') }}<span class="badge-pro">{{ trans('home.badge_pro') }}</span></h3>
            <p>{{ trans('home.feature.offerings_text') }}</p>
        </div>
        <div class="feature-card">
            <span class="icon">📅</span>
            <h3>{{ trans('home.feature.booking_title') }}<span class="badge-pro">{{ trans('home.badge_pro') }}</span></h3>
            <p>{{ trans('home.feature.booking_text') }}</p>
        </div>
    </div>

    <div class="section-heading">
        <h2>{{ trans('home.steps_heading') }}</h2>
    </div>

    <div class="steps">
        <div>
            <div class="step-number">1</div>
            <h3>{{ trans('home.step1_title') }}</h3>
            <p>{{ trans('home.step1_text') }}</p>
        </div>
        <div>
            <div class="step-number">2</div>
            <h3>{{ trans('home.step2_title') }}</h3>
            <p>{{ trans('home.step2_text') }}</p>
        </div>
        <div>
            <div class="step-number">3</div>
            <h3>{{ trans('home.step3_title') }}</h3>
            <p>{{ trans('home.step3_text') }}</p>
        </div>
    </div>

    <div class="cta-banner cta-banner-muted" style="margin-top:3.5rem;">
        <h2 style="font-size:1.2rem;">{{ trans('home.pricing_teaser_heading') }}</h2>
        <p>{{ trans('home.pricing_teaser_text') }}</p>
        <a class="btn" href="/pricing">{{ trans('home.pricing_teaser_cta') }}</a>
    </div>

    <div class="teams-section">
        <div class="teams-section-text">
            <span class="eyebrow">{{ trans('home.teams.eyebrow') }}</span>
            <h2>{{ trans('home.teams.heading') }}</h2>
            <ul class="teams-checklist">
                <li>{{ trans('home.teams.point_1') }}</li>
                <li>{{ trans('home.teams.point_2') }}</li>
                <li>{{ trans('home.teams.point_3') }}</li>
            </ul>
        </div>
        <div class="teams-section-price">
            <p class="teams-price">{{ trans('home.teams.price') }}</p>
            <a class="btn" href="/digitale-visitenkarte-unternehmen">{{ trans('home.teams.cta') }}</a>
        </div>
    </div>

    <div class="cta-banner cta-banner-primary">
        <h2>{{ trans('home.final_cta_heading') }}</h2>
        <p>{{ trans('home.final_cta_text') }}</p>
        <a class="btn" href="/register">{{ trans('home.final_cta_button') }}</a>
    </div>
{% endblock %}
