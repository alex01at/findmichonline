{% extends 'layout/base.twig' %}

{% block title %}{{ heading }} – findmichonline{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block body %}
    <div class="card">
        <h1>{{ heading }}</h1>
        {% if content %}
            <p style="white-space:pre-line;">{{ content }}</p>
        {% else %}
            <p class="muted-link">{{ trans('legal.placeholder_text') }}</p>
        {% endif %}
    </div>
{% endblock %}
