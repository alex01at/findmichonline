{% extends 'layout/base.twig' %}

{% block title %}{{ card.display_name }}{% if card.job_title or card.company %} – {{ card.job_title }}{% if card.job_title and card.company %} {{ trans('card.public.at') }} {% endif %}{{ card.company }}{% endif %}{% endblock %}
{% block meta_description %}{{ meta_description }}{% endblock %}
{% block robots %}index, follow{% endblock %}
{% block og_type %}profile{% endblock %}
{% block structured_data %}<script type="application/ld+json">{{ structured_data_json|raw }}</script>{% endblock %}
{% block main_class %}card-public{% endblock %}
{% block header_nav %}{% endblock %}

{% block body %}
    {% set is_pro = card.owner_plan == 'pro' %}
    {% set avatar_path = card.photo_path ?: card.logo_path %}
    {% set has_custom = is_pro and card.use_custom_colors %}
    {% set c_bg = has_custom and card.color_background ? card.color_background : '#ffffff' %}
    {% set c_header = has_custom and card.color_header ? card.color_header : '#ffffff' %}
    {# Muted graphite instead of the brand blue used elsewhere, to keep this design reading as restrained/corporate. #}
    {% set c_accent = has_custom and card.color_content ? card.color_content : (is_pro ? '#1e293b' : '#6b7280') %}
    {% set c_footer = has_custom and card.color_footer ? card.color_footer : '#f8fafc' %}
    {% set social_linkedin = is_pro ? '#0A66C2' : c_accent %}
    {% set social_instagram = is_pro ? '#E4405F' : c_accent %}
    {% set social_facebook = is_pro ? '#1877F2' : c_accent %}
    {% set social_youtube = is_pro ? '#FF0000' : c_accent %}

    <div style="background:{{ c_bg }}; border:1px solid var(--border); border-radius:6px; overflow:hidden; box-shadow:0 4px 18px rgba(20,25,40,0.05);">
        <div style="height:4px; background:{{ c_accent }};"></div>

        <div class="card-header-row" style="background:{{ c_header }}; display:flex; align-items:center; gap:1.5rem; padding:2.2rem 2.4rem 1.7rem 2.4rem; flex-wrap:wrap;">
            {% if avatar_path %}
                <img src="/{{ avatar_path }}" alt="{{ card.display_name }}" style="width:76px; height:76px; border-radius:6px; object-fit:cover; border:1px solid var(--border); flex-shrink:0;">
            {% endif %}
            <div>
                <h1 style="margin:0; font-size:1.5rem; letter-spacing:-0.01em;">{{ card.display_name }}</h1>
                {% if card.job_title %}
                    <p style="margin:0.4rem 0 0 0; color:{{ c_accent }}; font-weight:700; font-size:0.78rem; text-transform:uppercase; letter-spacing:0.09em;">{{ card.job_title }}</p>
                {% endif %}
                {% if card.company %}
                    <p style="margin:0.25rem 0 0 0; color:var(--muted); font-size:0.85rem; text-transform:uppercase; letter-spacing:0.06em;">{{ card.company }}</p>
                {% endif %}
                {% if category_name %}
                    <span style="display:inline-block; margin-top:0.6rem; padding:0.2rem 0.7rem; border:1px solid var(--border); border-radius:4px; font-size:0.72rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--muted);">{{ category_name }}</span>
                {% endif %}
            </div>
        </div>

        {% if card.bio %}
            <p style="padding:0 2.4rem; margin:0 0 1.5rem 0; color:var(--text);">{{ card.bio }}</p>
        {% endif %}

        <hr style="border:none; border-top:1px solid var(--border); margin:0 2.4rem;">

        <div style="padding:1.8rem 2.4rem; display:flex; gap:2.5rem; flex-wrap:wrap;">
            <div style="flex:2; min-width:260px;">
                {% if card.phone %}
                    <div style="display:flex; justify-content:space-between; align-items:baseline; gap:1rem; padding:0.6rem 0; border-bottom:1px solid var(--border);">
                        <span style="font-size:0.68rem; text-transform:uppercase; letter-spacing:0.09em; color:var(--muted);">{{ trans('card.public.call') }}</span>
                        <a href="/go/{{ card.slug }}/phone" style="color:{{ c_accent }}; font-size:0.92rem; text-decoration:none; font-weight:600;">{{ card.phone }}</a>
                    </div>
                {% endif %}
                {% if card.whatsapp %}
                    <div style="display:flex; justify-content:space-between; align-items:baseline; gap:1rem; padding:0.6rem 0; border-bottom:1px solid var(--border);">
                        <span style="font-size:0.68rem; text-transform:uppercase; letter-spacing:0.09em; color:var(--muted);">{{ trans('card.public.whatsapp_action') }}</span>
                        <a href="/go/{{ card.slug }}/whatsapp" target="_blank" rel="noopener" style="color:{{ c_accent }}; font-size:0.92rem; text-decoration:none; font-weight:600;">{{ card.whatsapp }}</a>
                    </div>
                {% endif %}
                {% if card.email %}
                    <div style="display:flex; justify-content:space-between; align-items:baseline; gap:1rem; padding:0.6rem 0; border-bottom:1px solid var(--border);">
                        <span style="font-size:0.68rem; text-transform:uppercase; letter-spacing:0.09em; color:var(--muted);">{{ trans('card.public.email_action') }}</span>
                        <a href="/go/{{ card.slug }}/email" style="color:{{ c_accent }}; font-size:0.92rem; text-decoration:none; font-weight:600;">{{ card.email }}</a>
                    </div>
                {% endif %}
                {% if card.website %}
                    <div style="display:flex; justify-content:space-between; align-items:baseline; gap:1rem; padding:0.6rem 0; border-bottom:1px solid var(--border);">
                        <span style="font-size:0.68rem; text-transform:uppercase; letter-spacing:0.09em; color:var(--muted);">{{ trans('card.public.website_action') }}</span>
                        <a href="/go/{{ card.slug }}/website" target="_blank" rel="noopener" style="color:{{ c_accent }}; font-size:0.92rem; text-decoration:none; font-weight:600;">{{ card.website }}</a>
                    </div>
                {% endif %}
                {% if card.address %}
                    <div style="display:flex; justify-content:space-between; align-items:baseline; gap:1rem; padding:0.6rem 0; border-bottom:1px solid var(--border);">
                        <span style="font-size:0.68rem; text-transform:uppercase; letter-spacing:0.09em; color:var(--muted);">{{ trans('card.public.route') }}</span>
                        <a href="/go/{{ card.slug }}/address" target="_blank" rel="noopener" style="color:{{ c_accent }}; font-size:0.92rem; text-decoration:none; font-weight:600; text-align:right;">{{ card.address }}</a>
                    </div>
                {% endif %}

                {% if card.linkedin_url or card.instagram_url or card.facebook_url or card.youtube_url %}
                    <div style="display:flex; gap:0.6rem; margin-top:1.3rem;">
                        {% if card.linkedin_url %}<a href="/go/{{ card.slug }}/linkedin" target="_blank" rel="noopener" style="width:32px; height:32px; border-radius:6px; background:{{ social_linkedin }}; color:#fff; display:flex; align-items:center; justify-content:center; text-decoration:none; font-weight:700; font-size:0.8rem;">in</a>{% endif %}
                        {% if card.instagram_url %}<a href="/go/{{ card.slug }}/instagram" target="_blank" rel="noopener" style="width:32px; height:32px; border-radius:6px; background:{{ social_instagram }}; color:#fff; display:flex; align-items:center; justify-content:center; text-decoration:none; font-size:0.9rem;">📷</a>{% endif %}
                        {% if card.facebook_url %}<a href="/go/{{ card.slug }}/facebook" target="_blank" rel="noopener" style="width:32px; height:32px; border-radius:6px; background:{{ social_facebook }}; color:#fff; display:flex; align-items:center; justify-content:center; text-decoration:none; font-weight:700; font-size:0.9rem;">f</a>{% endif %}
                        {% if card.youtube_url %}<a href="/go/{{ card.slug }}/youtube" target="_blank" rel="noopener" style="width:32px; height:32px; border-radius:6px; background:{{ social_youtube }}; color:#fff; display:flex; align-items:center; justify-content:center; text-decoration:none; font-size:0.85rem;">▶</a>{% endif %}
                    </div>
                {% endif %}
            </div>

            <div style="text-align:center;">
                <img src="/qr/{{ card.slug }}.png" alt="QR" width="140" height="140" style="border-radius:6px; border:1px solid var(--border);">
                <p style="font-size:0.78rem; color:var(--muted); margin:0.5rem 0 0 0; max-width:140px;">{{ trans('card.public.qr_caption') }}</p>
                {% if is_pro and card.booking_url %}
                    <a href="/go/{{ card.slug }}/booking" target="_blank" rel="noopener" style="margin-top:0.8rem; display:block; background:{{ c_accent }}; border:1.5px solid {{ c_accent }}; color:#fff; font-size:0.78rem; font-weight:600; padding:0.5rem 1.1rem; border-radius:6px; text-decoration:none;">{{ trans('card.public.booking_button') }}</a>
                {% endif %}
                {% if is_pro %}
                    <a href="/vcard/{{ card.slug }}.vcf" style="margin-top:0.6rem; display:block; background:transparent; border:1.5px solid {{ c_accent }}; color:{{ c_accent }}; font-size:0.78rem; font-weight:600; padding:0.5rem 1.1rem; border-radius:6px; text-decoration:none;">{{ trans('card.public.save_contact') }}</a>
                {% endif %}
            </div>
        </div>

        {% if is_pro and offerings|length > 0 %}
            <div style="margin:0 2.4rem 1.8rem 2.4rem; padding-top:1.3rem; border-top:1px solid var(--border);">
                <span style="font-size:0.68rem; text-transform:uppercase; letter-spacing:0.09em; color:var(--muted); font-weight:700;">{{ trans('card.public.offerings_heading') }}</span>
                <div style="margin-top:0.8rem;">
                    {% for offering in offerings %}
                        <div style="padding:0.6rem 0; border-bottom:1px solid var(--border);">
                            <div style="font-weight:600;">{{ offering.title }}{% if offering.price %} <span style="font-weight:normal; color:var(--muted);">– {{ offering.price }}</span>{% endif %}</div>
                            {% if offering.description %}<div style="color:var(--muted); font-size:0.9rem; margin-top:0.2rem;">{{ offering.description }}</div>{% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {% if is_pro and gallery_images|length > 0 %}
            <div style="margin:0 2.4rem 1.8rem 2.4rem; padding-top:1.3rem; border-top:1px solid var(--border);">
                <span style="font-size:0.68rem; text-transform:uppercase; letter-spacing:0.09em; color:var(--muted); font-weight:700;">{{ trans('card.public.gallery_heading') }}</span>
                <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(110px, 1fr)); gap:0.6rem; margin-top:0.8rem;">
                    {% for image in gallery_images %}
                        <a href="/{{ image.image_path }}" data-lightbox target="_blank" rel="noopener">
                            <img src="/{{ image.image_path }}" alt="" style="width:100%; height:110px; object-fit:cover; border-radius:4px; border:1px solid var(--border); display:block;">
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {% if card.opening_hours %}
            <div style="margin:0 2.4rem 1.8rem 2.4rem; padding-top:1.3rem; border-top:1px solid var(--border);">
                <span style="font-size:0.68rem; text-transform:uppercase; letter-spacing:0.09em; color:var(--muted); font-weight:700;">{{ trans('card.public.opening_hours') }}</span>
                <p style="white-space:pre-line; margin:0.5rem 0 0 0;">{{ card.opening_hours }}</p>
            </div>
        {% endif %}

        {% if is_pro %}
            <div style="background:{{ c_footer }}; padding:0.9rem; border-top:1px solid var(--border);">&nbsp;</div>
        {% else %}
            <div style="background:var(--bg); text-align:center; padding:0.9rem; font-size:0.8rem; color:var(--muted); border-top:1px solid var(--border);">
                <a href="/" style="color:inherit; text-decoration:underline;">{{ trans('card.public.footer_branding') }}</a>
            </div>
        {% endif %}
    </div>
{% endblock %}
