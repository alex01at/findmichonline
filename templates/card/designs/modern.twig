{% extends 'layout/base.twig' %}

{% block title %}{{ card.display_name }} – Kartenlink{% endblock %}
{% block main_class %}card-public{% endblock %}

{% block body %}
    <div style="
        background: linear-gradient(135deg, #3b5bfd, #7c3aed);
        color: #fff;
        border-radius: 16px;
        padding: 3rem 2rem;
        text-align: center;
        box-shadow: 0 20px 40px rgba(59, 91, 253, 0.25);
    ">
        {% if card.logo_path %}
            <img src="/{{ card.logo_path }}" alt="{{ card.display_name }}" style="max-height:88px; max-width:88px; object-fit:contain; border-radius:16px; background:rgba(255,255,255,0.15); padding:0.5rem; margin:0 auto 1.2rem auto; display:block;">
        {% else %}
            <div style="
                width: 88px; height: 88px; border-radius: 50%;
                background: rgba(255,255,255,0.15);
                display: flex; align-items: center; justify-content: center;
                margin: 0 auto 1.2rem auto;
                font-size: 2rem; font-weight: 700;
            ">
                {{ card.display_name|slice(0, 1)|upper }}
            </div>
        {% endif %}

        <h1 style="margin: 0 0 0.2rem 0;">{{ card.display_name }}</h1>

        {% if card.job_title or card.company %}
            <p style="opacity:0.85; margin-top:0;">
                {{ card.job_title }}{% if card.job_title and card.company %} {{ trans('card.public.at') }} {% endif %}{{ card.company }}
            </p>
        {% endif %}

        {% if card.bio %}
            <p style="opacity:0.95; max-width:340px; margin:1rem auto;">{{ card.bio }}</p>
        {% endif %}

        {% if card.phone %}
            <a href="tel:{{ card.phone }}" style="display:inline-block; margin-top:1rem; color:#fff; text-decoration:none; background:var(--success); padding:0.8rem 2rem; border-radius:999px; font-weight:600;">
                📞 {{ card.phone }}
            </a>
        {% endif %}

        <div style="margin-top: 1.5rem; display:flex; flex-direction:column; gap:0.7rem;">
            {% if card.email %}
                <a href="mailto:{{ card.email }}" style="color:#fff; text-decoration:none; background:rgba(255,255,255,0.15); padding:0.6rem 1rem; border-radius:8px;">✉️ {{ card.email }}</a>
            {% endif %}
            {% if card.website %}
                <a href="{{ card.website starts with 'http' ? card.website : 'https://' ~ card.website }}" target="_blank" rel="noopener" style="color:#fff; text-decoration:none; background:rgba(255,255,255,0.15); padding:0.6rem 1rem; border-radius:8px;">🌐 {{ card.website }}</a>
            {% endif %}
            {% if card.address %}
                <div style="background:rgba(255,255,255,0.15); padding:0.6rem 1rem; border-radius:8px;">📍 {{ card.address }}</div>
            {% endif %}
        </div>

        {% if card.opening_hours %}
            <div style="margin-top:1.5rem; text-align:left; background:rgba(255,255,255,0.15); padding:0.8rem 1rem; border-radius:8px;">
                <strong>{{ trans('card.public.opening_hours') }}</strong>
                <p style="white-space:pre-line; margin:0.4rem 0 0 0;">{{ card.opening_hours }}</p>
            </div>
        {% endif %}
    </div>
{% endblock %}
