{% extends 'layout/base.twig' %}

{% block title %}{{ card.display_name }}{% if card.job_title or card.company %} – {{ card.job_title }}{% if card.job_title and card.company %} {{ trans('card.public.at') }} {% endif %}{{ card.company }}{% endif %}{% endblock %}
{% block meta_description %}{{ meta_description }}{% endblock %}
{% block robots %}index, follow{% endblock %}
{% block og_type %}profile{% endblock %}
{% block structured_data %}<script type="application/ld+json">{{ structured_data_json|raw }}</script>{% endblock %}
{% block main_class %}card-public{% endblock %}
{% block header_nav %}{% endblock %}

{% block body %}
    {% set is_pro = card.owner_plan == 'pro' %}
    {% set avatar_path = card.photo_path ?: card.logo_path %}
    {% set has_custom = is_pro and card.use_custom_colors %}
    {% set c_bg = has_custom and card.color_background ? card.color_background : 'var(--card-bg)' %}
    {# Free cards get the plain gray hero instead of the dark navy/teal gradient. #}
    {% set c_header = has_custom and card.color_header ? card.color_header : (is_pro ? '#0f1b3d' : '#f5f6fa') %}
    {% set c_accent = has_custom and card.color_content ? card.color_content : (is_pro ? '#14b8a6' : '#6b7280') %}
    {# Darker variant of c_accent, used only where it's a solid background behind white
       button text (c_accent itself stays bright since it also colors the job title text
       sitting on the dark navy header, where the brighter teal is what keeps that legible). #}
    {% set c_accent_solid = has_custom and card.color_content ? card.color_content : (is_pro ? '#0c6f65' : '#6b7280') %}
    {% set c_footer = has_custom and card.color_footer ? card.color_footer : '#0f1b3d' %}
    {# Text stays white only for the default dark navy header; a custom header color or
       the plain Free header both get dark text since we don't know a custom color's luminance. #}
    {% set header_is_default_dark = is_pro and not (has_custom and card.color_header) %}
    {% set header_text = header_is_default_dark ? '#fff' : '#1f2430' %}
    {% set header_muted = header_is_default_dark ? 'rgba(255,255,255,0.85)' : 'var(--muted)' %}
    {% set social_linkedin = is_pro ? '#0A66C2' : c_accent %}
    {% set social_instagram = is_pro ? '#E4405F' : c_accent %}
    {% set social_facebook = is_pro ? '#1877F2' : c_accent %}
    {% set social_youtube = is_pro ? '#FF0000' : c_accent %}

    <div style="background:{{ c_bg }}; border-radius:16px; overflow:hidden; box-shadow:0 20px 40px rgba(15,27,61,0.18);">

        <div style="position:relative; background:{{ c_header }}; overflow:hidden;">
            {% if is_pro %}
                <div style="position:absolute; top:0; right:0; bottom:0; width:50%; background:{{ c_accent }}; clip-path:polygon(65% 0, 100% 0, 100% 100%, 30% 100%); z-index:0; opacity:0.9;"></div>
            {% endif %}

            <div style="position:relative; z-index:1; padding:2rem;">
                {% if card.logo_path or card.company %}
                    <div class="card-header-row" style="display:flex; align-items:center; gap:0.6rem; margin-bottom:1.3rem;">
                        {% if card.logo_path %}
                            <img src="/{{ card.logo_path }}" alt="" style="width:34px; height:34px; object-fit:contain; border-radius:6px;">
                        {% endif %}
                        {% if card.company %}
                            <div style="color:{{ header_text }}; font-weight:800; letter-spacing:0.5px; text-transform:uppercase;">{{ card.company }}</div>
                        {% endif %}
                    </div>
                {% endif %}

                <div class="card-header-row" style="display:flex; align-items:center; gap:1.2rem; flex-wrap:wrap;">
                    {% if avatar_path %}
                        <img src="/{{ avatar_path }}" alt="{{ card.display_name }}" style="width:96px; height:96px; border-radius:50%; object-fit:cover; border:3px solid rgba(255,255,255,0.9);">
                    {% endif %}
                    <div>
                        <h1 style="color:{{ header_text }}; margin:0;">{{ card.display_name }}</h1>
                        {% if card.job_title %}
                            <p style="color:{{ c_accent }}; margin:0.2rem 0 0 0; font-weight:600;">{{ card.job_title }}</p>
                        {% endif %}
                        {% if card.company %}
                            <p style="color:{{ header_muted }}; margin:0.1rem 0 0 0;">{{ card.company }}</p>
                        {% endif %}
                        {% if category_name %}
                            <span style="display:inline-block; margin-top:0.5rem; padding:0.2rem 0.7rem; border:1px solid {{ header_muted }}; border-radius:999px; font-size:0.78rem; color:{{ header_muted }};">{{ category_name }}</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {% if card.phone or card.email or card.website or card.address or card.whatsapp %}
            <div style="display:flex; gap:0.8rem; padding:1.3rem 2rem 0.5rem 2rem; flex-wrap:wrap; justify-content:center;">
                {% if card.phone %}
                    <a href="/go/{{ card.slug }}/phone" style="display:flex; flex-direction:column; align-items:center; gap:0.3rem; background:var(--bg); border:1px solid var(--border); border-radius:12px; padding:0.7rem 1.3rem; text-decoration:none; color:var(--text); font-size:0.85rem; min-width:80px;">
                        <span style="font-size:1.1rem;">📞</span>{{ trans('card.public.call') }}
                    </a>
                {% endif %}
                {% if card.whatsapp %}
                    <a href="/go/{{ card.slug }}/whatsapp" target="_blank" rel="noopener" style="display:flex; flex-direction:column; align-items:center; gap:0.3rem; background:var(--bg); border:1px solid var(--border); border-radius:12px; padding:0.7rem 1.3rem; text-decoration:none; color:var(--text); font-size:0.85rem; min-width:80px;">
                        <span style="font-size:1.1rem;">💬</span>{{ trans('card.public.whatsapp_action') }}
                    </a>
                {% endif %}
                {% if card.email %}
                    <a href="/go/{{ card.slug }}/email" style="display:flex; flex-direction:column; align-items:center; gap:0.3rem; background:var(--bg); border:1px solid var(--border); border-radius:12px; padding:0.7rem 1.3rem; text-decoration:none; color:var(--text); font-size:0.85rem; min-width:80px;">
                        <span style="font-size:1.1rem;">✉️</span>{{ trans('card.public.email_action') }}
                    </a>
                {% endif %}
                {% if card.website %}
                    <a href="/go/{{ card.slug }}/website" target="_blank" rel="noopener" style="display:flex; flex-direction:column; align-items:center; gap:0.3rem; background:var(--bg); border:1px solid var(--border); border-radius:12px; padding:0.7rem 1.3rem; text-decoration:none; color:var(--text); font-size:0.85rem; min-width:80px;">
                        <span style="font-size:1.1rem;">🌐</span>{{ trans('card.public.website_action') }}
                    </a>
                {% endif %}
                {% if card.address %}
                    <a href="/go/{{ card.slug }}/address" target="_blank" rel="noopener" style="display:flex; flex-direction:column; align-items:center; gap:0.3rem; background:var(--bg); border:1px solid var(--border); border-radius:12px; padding:0.7rem 1.3rem; text-decoration:none; color:var(--text); font-size:0.85rem; min-width:80px;">
                        <span style="font-size:1.1rem;">📍</span>{{ trans('card.public.route') }}
                    </a>
                {% endif %}
            </div>
        {% endif %}

        <div style="padding:0.8rem 2rem 0 2rem;">
            {% if card.phone %}<div style="margin-bottom:0.6rem;">📞 {{ card.phone }}</div>{% endif %}
            {% if card.whatsapp %}<div style="margin-bottom:0.6rem;">💬 {{ card.whatsapp }}</div>{% endif %}
            {% if card.email %}<div style="margin-bottom:0.6rem;">✉️ {{ card.email }}</div>{% endif %}
            {% if card.website %}<div style="margin-bottom:0.6rem;">🌐 {{ card.website }}</div>{% endif %}
            {% if card.address %}<div style="margin-bottom:0.6rem;">📍 {{ card.address }}</div>{% endif %}
        </div>

        {% if card.linkedin_url or card.instagram_url or card.facebook_url or card.youtube_url %}
            <div style="display:flex; gap:0.6rem; padding:0.5rem 2rem 0 2rem;">
                {% if card.linkedin_url %}<a href="/go/{{ card.slug }}/linkedin" target="_blank" rel="noopener" style="width:36px; height:36px; border-radius:50%; background:{{ social_linkedin }}; color:#fff; display:flex; align-items:center; justify-content:center; text-decoration:none; font-weight:700; font-size:0.85rem;">in</a>{% endif %}
                {% if card.instagram_url %}<a href="/go/{{ card.slug }}/instagram" target="_blank" rel="noopener" style="width:36px; height:36px; border-radius:50%; background:{{ social_instagram }}; color:#fff; display:flex; align-items:center; justify-content:center; text-decoration:none; font-size:1rem;">📷</a>{% endif %}
                {% if card.facebook_url %}<a href="/go/{{ card.slug }}/facebook" target="_blank" rel="noopener" style="width:36px; height:36px; border-radius:50%; background:{{ social_facebook }}; color:#fff; display:flex; align-items:center; justify-content:center; text-decoration:none; font-weight:700; font-size:0.95rem;">f</a>{% endif %}
                {% if card.youtube_url %}<a href="/go/{{ card.slug }}/youtube" target="_blank" rel="noopener" style="width:36px; height:36px; border-radius:50%; background:{{ social_youtube }}; color:#fff; display:flex; align-items:center; justify-content:center; text-decoration:none; font-size:0.9rem;">▶</a>{% endif %}
            </div>
        {% endif %}

        <div style="display:flex; gap:2rem; padding:1.5rem 2rem; flex-wrap:wrap;">
            {% if card.bio %}
                <p style="flex:2; min-width:220px; margin:0;">{{ card.bio }}</p>
            {% endif %}
            <div style="text-align:center;">
                <img src="{{ qr_url|default('/qr/' ~ card.slug ~ '.png') }}" alt="QR" width="130" height="130" style="border-radius:8px; border:1px solid var(--border);">
                <p style="font-size:0.8rem; color:var(--muted); margin:0.4rem 0 0 0; max-width:130px;">{{ trans('card.public.qr_caption') }}</p>
                {% if is_pro and card.booking_url %}
                    <a class="btn" href="/go/{{ card.slug }}/booking" target="_blank" rel="noopener" style="margin-top:0.7rem; background:{{ c_accent_solid }}; font-size:0.85rem; padding:0.5rem 1rem; display:block;">📅 {{ trans('card.public.booking_button') }}</a>
                {% endif %}
                {% if is_pro %}
                    <a class="btn" href="/vcard/{{ card.slug }}.vcf" style="margin-top:0.7rem; background:{{ c_accent_solid }}; font-size:0.85rem; padding:0.5rem 1rem; display:block;">💾 {{ trans('card.public.save_contact') }}</a>
                {% endif %}
            </div>
        </div>

        {% if is_pro and offerings|length > 0 %}
            <div style="margin:0 2rem 1.5rem 2rem; padding-top:1.2rem; border-top:1px solid var(--border);">
                <strong>{{ trans('card.public.offerings_heading') }}</strong>
                <div style="margin-top:0.7rem;">
                    {% for offering in offerings %}
                        <div style="padding:0.6rem 0; border-bottom:1px solid var(--border);">
                            <div style="font-weight:600;">{{ offering.title }}{% if offering.price %} <span style="font-weight:normal; color:var(--muted);">– {{ offering.price }}</span>{% endif %}</div>
                            {% if offering.description %}<div style="color:var(--muted); font-size:0.9rem; margin-top:0.2rem;">{{ offering.description }}</div>{% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {% if is_pro and gallery_images|length > 0 %}
            <div style="margin:0 2rem 1.5rem 2rem; padding-top:1.2rem; border-top:1px solid var(--border);">
                <strong>{{ trans('card.public.gallery_heading') }}</strong>
                <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(110px, 1fr)); gap:0.6rem; margin-top:0.7rem;">
                    {% for image in gallery_images %}
                        <a href="/{{ image.image_path }}" data-lightbox target="_blank" rel="noopener">
                            <img src="/{{ image.image_path }}" alt="" loading="lazy" style="width:100%; height:110px; object-fit:cover; border-radius:8px; border:1px solid var(--border); display:block;">
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {% if card.opening_hours %}
            <div style="margin:0 2rem 1.5rem 2rem; padding-top:1.2rem; border-top:1px solid var(--border);">
                <strong>{{ trans('card.public.opening_hours') }}</strong>
                <p style="white-space:pre-line; margin:0.4rem 0 0 0;">{{ card.opening_hours }}</p>
            </div>
        {% endif %}

        {% if is_pro %}
            <div style="background:{{ c_footer }}; padding:0.9rem;">&nbsp;</div>
        {% else %}
            <div style="background:var(--bg); color:var(--muted); text-align:center; padding:0.9rem; font-size:0.85rem; border-top:1px solid var(--border);">
                💚 <a href="/" style="color:inherit; text-decoration:underline;">{{ trans('card.public.footer_branding') }}</a>
            </div>
        {% endif %}
    </div>
{% endblock %}
