{% extends 'layout/base.twig' %}

{% block title %}{{ card.display_name }} – Kartenlink{% endblock %}
{% block main_class %}card-public{% endblock %}

{% block body %}
    <div style="background:var(--card-bg); border-radius:16px; overflow:hidden; box-shadow:0 20px 40px rgba(15,27,61,0.18);">

        <div style="position:relative; background:linear-gradient(135deg, #0f1b3d, #14284f); overflow:hidden;">
            <div style="position:absolute; top:0; right:0; bottom:0; width:50%; background:linear-gradient(135deg, #14b8a6, #0d9488); clip-path:polygon(65% 0, 100% 0, 100% 100%, 30% 100%); z-index:0;"></div>

            <div style="position:relative; z-index:1; padding:2rem;">
                {% if card.logo_path or card.company %}
                    <div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:1.3rem;">
                        {% if card.logo_path %}
                            <img src="/{{ card.logo_path }}" alt="" style="width:34px; height:34px; object-fit:contain; border-radius:6px;">
                        {% endif %}
                        {% if card.company %}
                            <div style="color:#fff; font-weight:800; letter-spacing:0.5px; text-transform:uppercase;">{{ card.company }}</div>
                        {% endif %}
                    </div>
                {% endif %}

                <div style="display:flex; align-items:center; gap:1.2rem; flex-wrap:wrap;">
                    {% if card.logo_path %}
                        <img src="/{{ card.logo_path }}" alt="{{ card.display_name }}" style="width:96px; height:96px; border-radius:50%; object-fit:cover; border:3px solid rgba(255,255,255,0.9);">
                    {% endif %}
                    <div>
                        <h1 style="color:#fff; margin:0;">{{ card.display_name }}</h1>
                        {% if card.job_title %}
                            <p style="color:#5eead4; margin:0.2rem 0 0 0; font-weight:600;">{{ card.job_title }}</p>
                        {% endif %}
                        {% if card.company %}
                            <p style="color:rgba(255,255,255,0.85); margin:0.1rem 0 0 0;">{{ card.company }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {% if card.phone or card.email or card.website or card.address %}
            <div style="display:flex; gap:0.8rem; padding:1.3rem 2rem 0.5rem 2rem; flex-wrap:wrap; justify-content:center;">
                {% if card.phone %}
                    <a href="tel:{{ card.phone }}" style="display:flex; flex-direction:column; align-items:center; gap:0.3rem; background:var(--bg); border:1px solid var(--border); border-radius:12px; padding:0.7rem 1.3rem; text-decoration:none; color:var(--text); font-size:0.85rem; min-width:80px;">
                        <span style="font-size:1.1rem;">📞</span>{{ trans('card.public.call') }}
                    </a>
                {% endif %}
                {% if card.email %}
                    <a href="mailto:{{ card.email }}" style="display:flex; flex-direction:column; align-items:center; gap:0.3rem; background:var(--bg); border:1px solid var(--border); border-radius:12px; padding:0.7rem 1.3rem; text-decoration:none; color:var(--text); font-size:0.85rem; min-width:80px;">
                        <span style="font-size:1.1rem;">✉️</span>{{ trans('card.public.email_action') }}
                    </a>
                {% endif %}
                {% if card.website %}
                    <a href="{{ card.website starts with 'http' ? card.website : 'https://' ~ card.website }}" target="_blank" rel="noopener" style="display:flex; flex-direction:column; align-items:center; gap:0.3rem; background:var(--bg); border:1px solid var(--border); border-radius:12px; padding:0.7rem 1.3rem; text-decoration:none; color:var(--text); font-size:0.85rem; min-width:80px;">
                        <span style="font-size:1.1rem;">🌐</span>{{ trans('card.public.website_action') }}
                    </a>
                {% endif %}
                {% if card.address %}
                    <a href="https://www.google.com/maps/search/?api=1&query={{ card.address|url_encode }}" target="_blank" rel="noopener" style="display:flex; flex-direction:column; align-items:center; gap:0.3rem; background:var(--bg); border:1px solid var(--border); border-radius:12px; padding:0.7rem 1.3rem; text-decoration:none; color:var(--text); font-size:0.85rem; min-width:80px;">
                        <span style="font-size:1.1rem;">📍</span>{{ trans('card.public.route') }}
                    </a>
                {% endif %}
            </div>
        {% endif %}

        <div style="padding:0.8rem 2rem 0 2rem;">
            {% if card.phone %}<div style="margin-bottom:0.6rem;">📞 {{ card.phone }}</div>{% endif %}
            {% if card.email %}<div style="margin-bottom:0.6rem;">✉️ {{ card.email }}</div>{% endif %}
            {% if card.website %}<div style="margin-bottom:0.6rem;">🌐 {{ card.website }}</div>{% endif %}
            {% if card.address %}<div style="margin-bottom:0.6rem;">📍 {{ card.address }}</div>{% endif %}
        </div>

        {% if card.linkedin_url or card.instagram_url or card.facebook_url or card.youtube_url %}
            <div style="display:flex; gap:0.6rem; padding:0.5rem 2rem 0 2rem;">
                {% if card.linkedin_url %}<a href="{{ card.linkedin_url }}" target="_blank" rel="noopener" style="width:36px; height:36px; border-radius:50%; background:#0A66C2; color:#fff; display:flex; align-items:center; justify-content:center; text-decoration:none; font-weight:700; font-size:0.85rem;">in</a>{% endif %}
                {% if card.instagram_url %}<a href="{{ card.instagram_url }}" target="_blank" rel="noopener" style="width:36px; height:36px; border-radius:50%; background:#E4405F; color:#fff; display:flex; align-items:center; justify-content:center; text-decoration:none; font-size:1rem;">📷</a>{% endif %}
                {% if card.facebook_url %}<a href="{{ card.facebook_url }}" target="_blank" rel="noopener" style="width:36px; height:36px; border-radius:50%; background:#1877F2; color:#fff; display:flex; align-items:center; justify-content:center; text-decoration:none; font-weight:700; font-size:0.95rem;">f</a>{% endif %}
                {% if card.youtube_url %}<a href="{{ card.youtube_url }}" target="_blank" rel="noopener" style="width:36px; height:36px; border-radius:50%; background:#FF0000; color:#fff; display:flex; align-items:center; justify-content:center; text-decoration:none; font-size:0.9rem;">▶</a>{% endif %}
            </div>
        {% endif %}

        <div style="display:flex; gap:2rem; padding:1.5rem 2rem; flex-wrap:wrap;">
            {% if card.bio %}
                <p style="flex:2; min-width:220px; margin:0;">{{ card.bio }}</p>
            {% endif %}
            <div style="text-align:center;">
                <img src="/qr/{{ card.slug }}.png" alt="QR" width="130" height="130" style="border-radius:8px; border:1px solid var(--border);">
                <p style="font-size:0.8rem; color:var(--muted); margin:0.4rem 0 0 0; max-width:130px;">{{ trans('card.public.qr_caption') }}</p>
            </div>
        </div>

        {% if card.opening_hours %}
            <div style="margin:0 2rem 1.5rem 2rem; padding-top:1.2rem; border-top:1px solid var(--border);">
                <strong>{{ trans('card.public.opening_hours') }}</strong>
                <p style="white-space:pre-line; margin:0.4rem 0 0 0;">{{ card.opening_hours }}</p>
            </div>
        {% endif %}

        <div style="background:#0f1b3d; color:rgba(255,255,255,0.85); text-align:center; padding:0.9rem; font-size:0.85rem;">
            💚 {{ trans('card.public.footer_branding') }}
        </div>
    </div>
{% endblock %}
