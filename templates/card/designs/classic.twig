{% extends 'layout/base.twig' %}

{% block title %}{{ card.display_name }}{% if card.job_title or card.company %} – {{ card.job_title }}{% if card.job_title and card.company %} {{ trans('card.public.at') }} {% endif %}{{ card.company }}{% endif %}{% endblock %}
{% block meta_description %}{{ meta_description }}{% endblock %}
{% block robots %}index, follow{% endblock %}
{% block og_type %}profile{% endblock %}
{% block structured_data %}<script type="application/ld+json">{{ structured_data_json|raw }}</script>{% endblock %}
{% block main_class %}card-public{% endblock %}
{% block header_nav %}{% endblock %}

{% block body %}
    {% set is_pro = card.owner_plan == 'pro' %}
    {% set avatar_path = card.photo_path ?: card.logo_path %}
    {% set has_custom = is_pro and card.use_custom_colors %}
    {% set c_bg = has_custom and card.color_background ? card.color_background : '#ffffff' %}
    {% set c_header = has_custom and card.color_header ? card.color_header : '#ffffff' %}
    {# Free cards get no brand color at all — everything that would normally
       use the blue accent (job title, action links, phone/social icons)
       falls back to plain gray instead. #}
    {% set c_accent = has_custom and card.color_content ? card.color_content : (is_pro ? '#3b5bfd' : '#6b7280') %}
    {% set c_footer = has_custom and card.color_footer ? card.color_footer : '#f5f6fa' %}
    {% set social_linkedin = is_pro ? '#0A66C2' : c_accent %}
    {% set social_instagram = is_pro ? '#E4405F' : c_accent %}
    {% set social_facebook = is_pro ? '#1877F2' : c_accent %}
    {% set social_youtube = is_pro ? '#FF0000' : c_accent %}

    <div style="background:{{ c_bg }}; border:1px solid var(--border); border-radius:16px; overflow:hidden; box-shadow:0 10px 30px rgba(20,25,40,0.06);">

        <div style="background:{{ c_header }};">
            {% if card.logo_path or card.company %}
                <div class="card-header-row" style="display:flex; align-items:center; gap:0.8rem; padding:1.8rem 2rem 0 2rem;">
                    {% if card.logo_path %}
                        <img src="/{{ card.logo_path }}" alt="" style="width:44px; height:44px; object-fit:contain; border-radius:8px; flex-shrink:0;">
                    {% endif %}
                    {% if card.company %}
                        <div style="font-weight:700; font-size:1.15rem;">{{ card.company }}</div>
                    {% endif %}
                </div>
            {% endif %}

            <div class="card-header-row" style="display:flex; align-items:center; gap:1.3rem; padding:1.5rem 2rem; flex-wrap:wrap;">
                {% if avatar_path %}
                    <img src="/{{ avatar_path }}" alt="{{ card.display_name }}" style="width:100px; height:100px; border-radius:50%; object-fit:cover; box-shadow:0 0 0 4px {{ c_header }};">
                {% endif %}
                <div>
                    <h1 style="margin:0;">{{ card.display_name }}</h1>
                    {% if card.job_title %}
                        <p style="margin:0.2rem 0 0 0; color:{{ c_accent }}; font-weight:600;">{{ card.job_title }}</p>
                    {% endif %}
                    {% if card.company %}
                        <p style="margin:0.1rem 0 0 0; color:var(--muted);">{{ card.company }}</p>
                    {% endif %}
                    {% if category_name %}
                        <span style="display:inline-block; margin-top:0.5rem; padding:0.2rem 0.7rem; border:1px solid var(--border); border-radius:999px; font-size:0.78rem; color:var(--muted);">{{ category_name }}</span>
                    {% endif %}
                </div>
            </div>
        </div>

        {% if card.bio %}
            <p style="padding:1rem 2rem 0 2rem; margin:0 0 1rem 0;">{{ card.bio }}</p>
        {% endif %}

        <hr style="border:none; border-top:1px solid var(--border); margin:0 2rem;">

        <div style="padding:1.5rem 2rem; display:flex; gap:2.5rem; flex-wrap:wrap;">
            <div style="flex:2; min-width:260px;">
                {% if card.phone %}
                    <div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-bottom:0.7rem;">
                        <span>📞 {{ card.phone }}</span>
                        <a href="/go/{{ card.slug }}/phone" style="color:{{ c_accent }}; font-size:0.9rem; white-space:nowrap;">{{ trans('card.public.call') }}</a>
                    </div>
                {% endif %}
                {% if card.whatsapp %}
                    <div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-bottom:0.7rem;">
                        <span>💬 {{ card.whatsapp }}</span>
                        <a href="/go/{{ card.slug }}/whatsapp" target="_blank" rel="noopener" style="color:{{ c_accent }}; font-size:0.9rem; white-space:nowrap;">{{ trans('card.public.whatsapp_action') }}</a>
                    </div>
                {% endif %}
                {% if card.email %}
                    <div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-bottom:0.7rem;">
                        <span>✉️ {{ card.email }}</span>
                        <a href="/go/{{ card.slug }}/email" style="color:{{ c_accent }}; font-size:0.9rem; white-space:nowrap;">{{ trans('card.public.email_action') }}</a>
                    </div>
                {% endif %}
                {% if card.website %}
                    <div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-bottom:0.7rem;">
                        <span>🌐 {{ card.website }}</span>
                        <a href="/go/{{ card.slug }}/website" target="_blank" rel="noopener" style="color:{{ c_accent }}; font-size:0.9rem; white-space:nowrap;">{{ trans('card.public.website_action') }}</a>
                    </div>
                {% endif %}
                {% if card.address %}
                    <div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-bottom:0.7rem;">
                        <span>📍 {{ card.address }}</span>
                        <a href="/go/{{ card.slug }}/address" target="_blank" rel="noopener" style="color:{{ c_accent }}; font-size:0.9rem; white-space:nowrap;">{{ trans('card.public.route') }}</a>
                    </div>
                {% endif %}

                {% if card.linkedin_url or card.instagram_url or card.facebook_url or card.youtube_url %}
                    <div style="display:flex; gap:0.6rem; margin-top:1.2rem;">
                        {% if card.linkedin_url %}<a href="/go/{{ card.slug }}/linkedin" target="_blank" rel="noopener" style="width:36px; height:36px; border-radius:50%; background:{{ social_linkedin }}; color:#fff; display:flex; align-items:center; justify-content:center; text-decoration:none; font-weight:700; font-size:0.85rem;">in</a>{% endif %}
                        {% if card.instagram_url %}<a href="/go/{{ card.slug }}/instagram" target="_blank" rel="noopener" style="width:36px; height:36px; border-radius:50%; background:{{ social_instagram }}; color:#fff; display:flex; align-items:center; justify-content:center; text-decoration:none; font-size:1rem;">📷</a>{% endif %}
                        {% if card.facebook_url %}<a href="/go/{{ card.slug }}/facebook" target="_blank" rel="noopener" style="width:36px; height:36px; border-radius:50%; background:{{ social_facebook }}; color:#fff; display:flex; align-items:center; justify-content:center; text-decoration:none; font-weight:700; font-size:0.95rem;">f</a>{% endif %}
                        {% if card.youtube_url %}<a href="/go/{{ card.slug }}/youtube" target="_blank" rel="noopener" style="width:36px; height:36px; border-radius:50%; background:{{ social_youtube }}; color:#fff; display:flex; align-items:center; justify-content:center; text-decoration:none; font-size:0.9rem;">▶</a>{% endif %}
                    </div>
                {% endif %}
            </div>

            <div style="text-align:center;">
                <img src="{{ qr_url|default('/qr/' ~ card.slug ~ '.png') }}" alt="QR" width="140" height="140" style="border-radius:8px; border:1px solid var(--border);">
                <p style="font-size:0.8rem; color:var(--muted); margin:0.4rem 0 0 0; max-width:140px;">{{ trans('card.public.qr_caption') }}</p>
                {% if is_pro and card.booking_url %}
                    <a class="btn" href="/go/{{ card.slug }}/booking" target="_blank" rel="noopener" style="margin-top:0.7rem; background:{{ c_accent }}; font-size:0.85rem; padding:0.5rem 1rem; display:block;">📅 {{ trans('card.public.booking_button') }}</a>
                {% endif %}
                {% if is_pro %}
                    <a class="btn" href="/vcard/{{ card.slug }}.vcf" style="margin-top:0.7rem; background:{{ c_accent }}; font-size:0.85rem; padding:0.5rem 1rem; display:block;">💾 {{ trans('card.public.save_contact') }}</a>
                {% endif %}
            </div>
        </div>

        {% if is_pro and offerings|length > 0 %}
            <div style="margin:0 2rem 1.5rem 2rem; padding-top:1.2rem; border-top:1px solid var(--border);">
                <strong>{{ trans('card.public.offerings_heading') }}</strong>
                <div style="margin-top:0.7rem;">
                    {% for offering in offerings %}
                        <div style="padding:0.6rem 0; border-bottom:1px solid var(--border);">
                            <div style="font-weight:600;">{{ offering.title }}{% if offering.price %} <span style="font-weight:normal; color:var(--muted);">– {{ offering.price }}</span>{% endif %}</div>
                            {% if offering.description %}<div style="color:var(--muted); font-size:0.9rem; margin-top:0.2rem;">{{ offering.description }}</div>{% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {% if card.opening_hours %}
            <div style="margin:0 2rem 1.5rem 2rem; padding-top:1.2rem; border-top:1px solid var(--border);">
                <strong>{{ trans('card.public.opening_hours') }}</strong>
                <p style="white-space:pre-line; margin:0.4rem 0 0 0;">{{ card.opening_hours }}</p>
            </div>
        {% endif %}

        {% if is_pro %}
            <div style="background:{{ c_footer }}; padding:0.9rem; border-top:1px solid var(--border);">&nbsp;</div>
        {% else %}
            <div style="background:var(--bg); text-align:center; padding:0.9rem; font-size:0.85rem; color:var(--muted); border-top:1px solid var(--border);">
                💙 <a href="/" style="color:inherit; text-decoration:underline;">{{ trans('card.public.footer_branding') }}</a>
            </div>
        {% endif %}
    </div>
{% endblock %}
