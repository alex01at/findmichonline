{% extends 'layout/base.twig' %}

{% block title %}{{ trans('card.edit.heading') }} – findmichonline{% endblock %}
{% block main_class %}wide{% endblock %}

{% block body %}
    <div class="card">
        <h1>{{ trans('card.edit.heading') }}</h1>

        {% if errors is defined and errors|length > 0 %}
            <ul class="errors">
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        {% endif %}

        {% if card and card.is_published %}
            <p class="muted-link">
                {{ trans('card.edit.published_notice') }}
                <a href="/{{ card.slug }}" target="_blank">/{{ card.slug }}</a>
            </p>
        {% endif %}

        <div class="tabs">
            <button type="button" class="tab-btn active" data-tab="content">{{ trans('card.edit.tab_content') }}</button>
            <button type="button" class="tab-btn" data-tab="design">{{ trans('card.edit.tab_design') }}</button>
            <button type="button" class="tab-btn" data-tab="gallery">{{ trans('card.edit.tab_gallery') }}</button>
            <button type="button" class="tab-btn" data-tab="offerings">{{ trans('card.edit.tab_offerings') }}</button>
        </div>

        <form method="post" action="/card/edit" enctype="multipart/form-data">
            <div class="tab-panel" data-tab-panel="content">
                <label for="display_name">{{ trans('card.edit.name_label') }}</label>
                <input type="text" id="display_name" name="display_name" value="{{ old.display_name|default('') }}" required>

                <label for="job_title">{{ trans('card.edit.job_title_label') }}</label>
                <input type="text" id="job_title" name="job_title" value="{{ old.job_title|default('') }}">

                <label for="company">{{ trans('card.edit.company_label') }}</label>
                <input type="text" id="company" name="company" value="{{ old.company|default('') }}">

                <label for="category_id">{{ trans('card.edit.category_label') }}</label>
                <select id="category_id" name="category_id" style="width:100%; padding:0.6rem 0.8rem; border:1px solid var(--border); border-radius:8px; font-size:1rem;">
                    <option value="">{{ trans('card.edit.category_none') }}</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}" {% if old.category_id|default(null) == category.id %}selected{% endif %}>{{ locale == 'de' ? category.name_de : category.name_en }}</option>
                    {% endfor %}
                </select>

                <label for="email">{{ trans('card.edit.email_label') }}</label>
                <input type="email" id="email" name="email" value="{{ old.email|default('') }}">

                <label for="phone">{{ trans('card.edit.phone_label') }}</label>
                <input type="text" id="phone" name="phone" value="{{ old.phone|default('') }}">

                <label for="website">{{ trans('card.edit.website_label') }}</label>
                <input type="text" id="website" name="website" value="{{ old.website|default('') }}">

                <label for="address">{{ trans('card.edit.address_label') }}</label>
                <input type="text" id="address" name="address" value="{{ old.address|default('') }}">

                <label for="bio">{{ trans('card.edit.bio_label') }}</label>
                <input type="text" id="bio" name="bio" value="{{ old.bio|default('') }}">

                <label for="opening_hours">{{ trans('card.edit.opening_hours_label') }}</label>
                <textarea id="opening_hours" name="opening_hours" rows="4" placeholder="{{ trans('card.edit.opening_hours_placeholder') }}" style="width:100%; padding:0.6rem 0.8rem; border:1px solid var(--border); border-radius:8px; font-size:1rem; font-family:inherit;">{{ old.opening_hours|default('') }}</textarea>

                <label for="logo">{{ trans('card.edit.logo_label') }}</label>
                {% if old.logo_path is defined and old.logo_path %}
                    <div style="margin-bottom:0.5rem;">
                        <img src="/{{ old.logo_path }}" alt="Logo" style="max-height:80px; border-radius:8px;">
                    </div>
                    <label style="display:flex; align-items:center; gap:0.5rem; font-weight:normal; margin-top:0;">
                        <input type="checkbox" name="remove_logo" value="1">
                        {{ trans('card.edit.logo_remove') }}
                    </label>
                {% endif %}
                <input type="file" id="logo" name="logo" accept="image/png,image/jpeg,image/webp">
                <p class="muted-link" style="margin-top:0.3rem;">{{ trans('card.edit.logo_hint') }}</p>

                <label style="margin-top:1.5rem; font-weight:600; color:var(--text);">{{ trans('card.edit.social_heading') }}</label>
                <label for="linkedin_url">{{ trans('card.edit.linkedin_label') }}</label>
                <input type="url" id="linkedin_url" name="linkedin_url" value="{{ old.linkedin_url|default('') }}" placeholder="https://linkedin.com/in/...">

                <label for="instagram_url">{{ trans('card.edit.instagram_label') }}</label>
                <input type="url" id="instagram_url" name="instagram_url" value="{{ old.instagram_url|default('') }}" placeholder="https://instagram.com/...">

                <label for="facebook_url">{{ trans('card.edit.facebook_label') }}</label>
                <input type="url" id="facebook_url" name="facebook_url" value="{{ old.facebook_url|default('') }}" placeholder="https://facebook.com/...">

                <label for="youtube_url">{{ trans('card.edit.youtube_label') }}</label>
                <input type="url" id="youtube_url" name="youtube_url" value="{{ old.youtube_url|default('') }}" placeholder="https://youtube.com/@...">

                <label for="booking_url" style="{% if not booking_link_allowed %}opacity:0.5;{% endif %}">{{ trans('card.edit.booking_url_label') }} {% if not booking_link_allowed %}{{ trans('card.edit.design_pro_only') }}{% endif %}</label>
                <input type="url" id="booking_url" name="booking_url" value="{{ old.booking_url|default('') }}" placeholder="https://calendly.com/..." {% if not booking_link_allowed %}disabled style="opacity:0.5;"{% endif %}>
                {% if not booking_link_allowed %}
                    <p class="muted-link" style="margin-top:0.4rem;">{{ trans('card.edit.booking_pro_hint') }} <a href="/pricing">{{ trans('dashboard.stats_locked_cta') }}</a></p>
                {% endif %}

                <label for="slug">{{ trans('card.edit.slug_label') }}</label>
                <input type="text" id="slug" name="slug" value="{{ old.slug|default('') }}" placeholder="{{ trans('card.edit.slug_placeholder') }}">

                <label style="display:flex; align-items:center; gap:0.5rem; margin-top:1rem;">
                    <input type="checkbox" name="is_published" value="1" {% if old.is_published %}checked{% endif %}>
                    {{ trans('card.edit.publish_label') }}
                </label>
            </div>

            <div class="tab-panel" data-tab-panel="design" hidden>
                <label>{{ trans('card.edit.design_label') }}</label>
                <div style="display:flex; gap:1rem; flex-wrap:wrap; margin-top:0.3rem;">
                    <label style="display:flex; align-items:center; gap:0.4rem; font-weight:normal; margin-top:0;">
                        <input type="radio" name="design" value="classic" {% if (old.design|default('classic')) == 'classic' %}checked{% endif %}>
                        {{ trans('card.edit.design_classic') }}
                    </label>
                    <label style="display:flex; align-items:center; gap:0.4rem; font-weight:normal; margin-top:0; {% if not design_pro_allowed %}opacity:0.5;{% endif %}">
                        <input type="radio" name="design" value="modern" {% if not design_pro_allowed %}disabled{% endif %} {% if (old.design|default('classic')) == 'modern' %}checked{% endif %}>
                        {{ trans('card.edit.design_modern') }} {% if not design_pro_allowed %}{{ trans('card.edit.design_pro_only') }}{% endif %}
                    </label>
                    <label style="display:flex; align-items:center; gap:0.4rem; font-weight:normal; margin-top:0; {% if not design_pro_allowed %}opacity:0.5;{% endif %}">
                        <input type="radio" name="design" value="professional" {% if not design_pro_allowed %}disabled{% endif %} {% if (old.design|default('classic')) == 'professional' %}checked{% endif %}>
                        {{ trans('card.edit.design_professional') }} {% if not design_pro_allowed %}{{ trans('card.edit.design_pro_only') }}{% endif %}
                    </label>
                    <label style="display:flex; align-items:center; gap:0.4rem; font-weight:normal; margin-top:0; {% if not design_pro_allowed %}opacity:0.5;{% endif %}">
                        <input type="radio" name="design" value="playful" {% if not design_pro_allowed %}disabled{% endif %} {% if (old.design|default('classic')) == 'playful' %}checked{% endif %}>
                        {{ trans('card.edit.design_playful') }} {% if not design_pro_allowed %}{{ trans('card.edit.design_pro_only') }}{% endif %}
                    </label>
                </div>
                {% if not design_pro_allowed %}
                    <p class="muted-link" style="margin-top:0.4rem;">{{ trans('card.edit.design_pro_hint') }}</p>
                {% endif %}

                <label style="margin-top:1.5rem; font-weight:600; color:var(--text);">{{ trans('card.edit.colors_heading') }}</label>
                <label style="display:flex; align-items:center; gap:0.5rem; font-weight:normal; margin-top:0.5rem; {% if not custom_colors_allowed %}opacity:0.5;{% endif %}">
                    <input type="checkbox" name="use_custom_colors" value="1" {% if not custom_colors_allowed %}disabled{% endif %} {% if old.use_custom_colors|default(false) %}checked{% endif %}>
                    {{ trans('card.edit.colors_enable') }}
                </label>
                {% if not custom_colors_allowed %}
                    <p class="muted-link" style="margin-top:0.4rem;">{{ trans('card.edit.colors_pro_hint') }} <a href="/pricing">{{ trans('dashboard.stats_locked_cta') }}</a></p>
                {% endif %}

                <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(160px, 1fr)); gap:1rem; margin-top:1rem; {% if not custom_colors_allowed %}opacity:0.5;{% endif %}">
                    <div>
                        <label for="color_background" style="margin-top:0;">{{ trans('card.edit.color_background_label') }}</label>
                        <input type="color" id="color_background" name="color_background" value="{{ old.color_background|default('#ffffff') }}" {% if not custom_colors_allowed %}disabled{% endif %} style="width:100%; height:2.4rem; padding:0.2rem; border:1px solid var(--border); border-radius:8px;">
                    </div>
                    <div>
                        <label for="color_header" style="margin-top:0;">{{ trans('card.edit.color_header_label') }}</label>
                        <input type="color" id="color_header" name="color_header" value="{{ old.color_header|default('#ffffff') }}" {% if not custom_colors_allowed %}disabled{% endif %} style="width:100%; height:2.4rem; padding:0.2rem; border:1px solid var(--border); border-radius:8px;">
                    </div>
                    <div>
                        <label for="color_content" style="margin-top:0;">{{ trans('card.edit.color_content_label') }}</label>
                        <input type="color" id="color_content" name="color_content" value="{{ old.color_content|default('#3b5bfd') }}" {% if not custom_colors_allowed %}disabled{% endif %} style="width:100%; height:2.4rem; padding:0.2rem; border:1px solid var(--border); border-radius:8px;">
                    </div>
                    <div>
                        <label for="color_footer" style="margin-top:0;">{{ trans('card.edit.color_footer_label') }}</label>
                        <input type="color" id="color_footer" name="color_footer" value="{{ old.color_footer|default('#f5f6fa') }}" {% if not custom_colors_allowed %}disabled{% endif %} style="width:100%; height:2.4rem; padding:0.2rem; border:1px solid var(--border); border-radius:8px;">
                    </div>
                </div>
            </div>

            <button type="submit">{{ trans('card.edit.submit') }}</button>
        </form>

        <div class="tab-panel" data-tab-panel="gallery" hidden>
            <label style="margin-top:0; font-weight:600; color:var(--text);">{{ trans('card.gallery.heading') }}</label>

            {% if not gallery_allowed %}
                <p class="muted-link" style="margin-top:0.4rem;">{{ trans('card.gallery.pro_hint') }} <a href="/pricing">{{ trans('dashboard.stats_locked_cta') }}</a></p>
            {% elseif not card %}
                <p class="muted-link" style="margin-top:0.4rem;">{{ trans('card.gallery.needs_card_hint') }}</p>
            {% else %}
                <p class="muted-link" style="margin-top:0.4rem;">{{ trans('card.gallery.hint', {max: gallery_max}) }}</p>

                <div id="gallery-grid" style="display:{% if gallery_images|length > 0 %}grid{% else %}none{% endif %}; grid-template-columns:repeat(auto-fill, minmax(120px, 1fr)); gap:0.8rem; margin-top:1rem;">
                    {% for image in gallery_images %}
                        <div class="gallery-tile" style="position:relative;">
                            <img src="/{{ image.image_path }}" alt="" style="width:100%; height:120px; object-fit:cover; border-radius:8px; border:1px solid var(--border); display:block;">
                            <form method="post" action="/card/gallery/{{ image.id }}/delete" class="gallery-delete-form" data-image-id="{{ image.id }}" style="margin:0;">
                                <button type="submit" style="position:absolute; top:6px; right:6px; margin:0; padding:0.2rem 0.55rem; font-size:0.75rem; background:var(--danger);">✕</button>
                            </form>
                        </div>
                    {% endfor %}
                </div>

                <div id="gallery-upload-wrap" {% if gallery_images|length >= gallery_max %}hidden{% endif %} style="margin-top:1.2rem;">
                    <form id="gallery-upload-form" method="post" action="/card/gallery/add" enctype="multipart/form-data">
                        <input type="file" id="gallery-image-input" name="gallery_image" accept="image/png,image/jpeg,image/webp" required>
                        <button type="submit" id="gallery-upload-btn">{{ trans('card.gallery.upload_button') }}</button>
                    </form>
                    <div id="gallery-progress-wrap" hidden style="margin-top:0.6rem;">
                        <div style="height:8px; background:var(--border); border-radius:999px; overflow:hidden;">
                            <div id="gallery-progress-bar" style="height:100%; width:0%; background:var(--primary); transition:width 0.15s;"></div>
                        </div>
                    </div>
                    <p id="gallery-error" class="muted-link" style="color:var(--danger); display:none; margin-top:0.5rem;"></p>
                </div>
                <p id="gallery-limit-hint" class="muted-link" style="margin-top:1rem; display:{% if gallery_images|length >= gallery_max %}block{% else %}none{% endif %};">{{ trans('card.gallery.limit_reached_hint') }}</p>
            {% endif %}
        </div>

        <div class="tab-panel" data-tab-panel="offerings" hidden>
            <label style="margin-top:0; font-weight:600; color:var(--text);">{{ trans('card.offerings.heading') }}</label>

            {% if not offerings_allowed %}
                <p class="muted-link" style="margin-top:0.4rem;">{{ trans('card.offerings.pro_hint') }} <a href="/pricing">{{ trans('dashboard.stats_locked_cta') }}</a></p>
            {% elseif not card %}
                <p class="muted-link" style="margin-top:0.4rem;">{{ trans('card.offerings.needs_card_hint') }}</p>
            {% else %}
                <p class="muted-link" style="margin-top:0.4rem;">{{ trans('card.offerings.hint', {max: offerings_max}) }}</p>

                <div id="offerings-list" style="display:{% if offerings|length > 0 %}block{% else %}none{% endif %}; margin-top:1rem;">
                    {% for offering in offerings %}
                        <div class="offering-item" style="position:relative; padding:0.8rem 2.2rem 0.8rem 0; border-bottom:1px solid var(--border);">
                            <div style="font-weight:600;">{{ offering.title }}{% if offering.price %} <span style="font-weight:normal; color:var(--muted);">– {{ offering.price }}</span>{% endif %}</div>
                            {% if offering.description %}<div style="color:var(--muted); font-size:0.9rem; margin-top:0.2rem;">{{ offering.description }}</div>{% endif %}
                            <form method="post" action="/card/offerings/{{ offering.id }}/delete" class="offering-delete-form" data-offering-id="{{ offering.id }}" style="margin:0;">
                                <button type="submit" style="position:absolute; top:0.7rem; right:0; margin:0; padding:0.2rem 0.55rem; font-size:0.75rem; background:var(--danger);">✕</button>
                            </form>
                        </div>
                    {% endfor %}
                </div>

                <div id="offerings-add-wrap" {% if offerings|length >= offerings_max %}hidden{% endif %} style="margin-top:1.2rem;">
                    <form id="offering-add-form" method="post" action="/card/offerings/add">
                        <label for="offering-title" style="margin-top:0;">{{ trans('card.offerings.title_label') }}</label>
                        <input type="text" id="offering-title" name="title" required>

                        <label for="offering-description">{{ trans('card.offerings.description_label') }}</label>
                        <input type="text" id="offering-description" name="description">

                        <label for="offering-price">{{ trans('card.offerings.price_label') }}</label>
                        <input type="text" id="offering-price" name="price" placeholder="z. B. ab 49 €">

                        <button type="submit" id="offering-add-btn">{{ trans('card.offerings.add_button') }}</button>
                    </form>
                    <p id="offering-error" class="muted-link" style="color:var(--danger); display:none; margin-top:0.5rem;"></p>
                </div>
                <p id="offerings-limit-hint" class="muted-link" style="margin-top:1rem; display:{% if offerings|length >= offerings_max %}block{% else %}none{% endif %};">{{ trans('card.offerings.limit_reached_hint') }}</p>
            {% endif %}
        </div>
    </div>

    {% if card %}
        <div class="card" style="margin-top:1.5rem; text-align:center;">
            <h1 style="font-size:1.2rem;">{{ trans('card.qr.heading') }}</h1>
            <p class="muted-link">{{ trans('card.qr.hint', {slug: card.slug}) }}</p>
            <img src="/card/qr.png" alt="{{ trans('card.qr.heading') }}" width="200" height="200" style="border-radius:8px;">
            <div>
                <a class="btn" href="/card/qr.png?download=1">{{ trans('card.qr.download_png') }}</a>
                <a class="btn" href="/card/qr.svg?download=1">{{ trans('card.qr.download_svg') }}</a>
            </div>
        </div>
    {% endif %}

    <script>
        (function () {
            var form = document.getElementById('gallery-upload-form');
            if (!form) return;

            var fileInput = document.getElementById('gallery-image-input');
            var uploadBtn = document.getElementById('gallery-upload-btn');
            var progressWrap = document.getElementById('gallery-progress-wrap');
            var progressBar = document.getElementById('gallery-progress-bar');
            var errorEl = document.getElementById('gallery-error');
            var grid = document.getElementById('gallery-grid');
            var uploadWrap = document.getElementById('gallery-upload-wrap');
            var limitHint = document.getElementById('gallery-limit-hint');
            var confirmText = {{ trans('card.gallery.confirm_delete')|json_encode|raw }};
            var genericError = {{ trans('card.gallery.errors.upload_failed')|json_encode|raw }};

            function showError(message) {
                errorEl.textContent = message || genericError;
                errorEl.style.display = 'block';
            }

            function bindDeleteForm(formEl) {
                formEl.addEventListener('submit', function (e) {
                    e.preventDefault();
                    if (!confirm(confirmText)) return;

                    var xhr = new XMLHttpRequest();
                    xhr.open('POST', formEl.getAttribute('action'));
                    xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
                    xhr.onload = function () {
                        if (xhr.status >= 200 && xhr.status < 300) {
                            formEl.closest('.gallery-tile').remove();
                            if (!grid.querySelector('.gallery-tile')) {
                                grid.style.display = 'none';
                            }
                            uploadWrap.hidden = false;
                            limitHint.style.display = 'none';
                        }
                    };
                    xhr.send();
                });
            }

            function addTile(image) {
                var div = document.createElement('div');
                div.className = 'gallery-tile';
                div.style.position = 'relative';
                div.innerHTML =
                    '<img src="/' + image.image_path + '" alt="" style="width:100%; height:120px; object-fit:cover; border-radius:8px; border:1px solid var(--border); display:block;">' +
                    '<form method="post" action="/card/gallery/' + image.id + '/delete" class="gallery-delete-form" data-image-id="' + image.id + '" style="margin:0;">' +
                    '<button type="submit" style="position:absolute; top:6px; right:6px; margin:0; padding:0.2rem 0.55rem; font-size:0.75rem; background:var(--danger);">✕</button>' +
                    '</form>';
                grid.appendChild(div);
                grid.style.display = 'grid';
                bindDeleteForm(div.querySelector('.gallery-delete-form'));
            }

            grid.querySelectorAll('.gallery-delete-form').forEach(bindDeleteForm);

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (!fileInput.files.length) return;

                errorEl.style.display = 'none';
                progressBar.style.width = '0%';
                progressWrap.hidden = false;
                uploadBtn.disabled = true;

                var formData = new FormData();
                formData.append('gallery_image', fileInput.files[0]);

                var xhr = new XMLHttpRequest();
                xhr.open('POST', form.getAttribute('action'));
                xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');

                xhr.upload.addEventListener('progress', function (evt) {
                    if (evt.lengthComputable) {
                        progressBar.style.width = Math.round((evt.loaded / evt.total) * 100) + '%';
                    }
                });

                xhr.onload = function () {
                    uploadBtn.disabled = false;
                    progressWrap.hidden = true;

                    var data = null;
                    try {
                        data = JSON.parse(xhr.responseText);
                    } catch (err) {
                        data = null;
                    }

                    if (data && data.success && data.image) {
                        addTile(data.image);
                        fileInput.value = '';
                        if (data.remaining <= 0) {
                            uploadWrap.hidden = true;
                            limitHint.style.display = 'block';
                        }
                    } else {
                        showError(data ? data.error : null);
                    }
                };

                xhr.onerror = function () {
                    uploadBtn.disabled = false;
                    progressWrap.hidden = true;
                    showError(null);
                };

                xhr.send(formData);
            });
        })();

        (function () {
            var form = document.getElementById('offering-add-form');
            if (!form) return;

            var titleInput = document.getElementById('offering-title');
            var descriptionInput = document.getElementById('offering-description');
            var priceInput = document.getElementById('offering-price');
            var addBtn = document.getElementById('offering-add-btn');
            var errorEl = document.getElementById('offering-error');
            var list = document.getElementById('offerings-list');
            var addWrap = document.getElementById('offerings-add-wrap');
            var limitHint = document.getElementById('offerings-limit-hint');
            var confirmText = {{ trans('card.offerings.confirm_delete')|json_encode|raw }};
            var genericError = {{ trans('card.offerings.errors.generic')|json_encode|raw }};

            function showError(message) {
                errorEl.textContent = message || genericError;
                errorEl.style.display = 'block';
            }

            function escapeHtml(text) {
                var div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            function bindDeleteForm(formEl) {
                formEl.addEventListener('submit', function (e) {
                    e.preventDefault();
                    if (!confirm(confirmText)) return;

                    var xhr = new XMLHttpRequest();
                    xhr.open('POST', formEl.getAttribute('action'));
                    xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
                    xhr.onload = function () {
                        if (xhr.status >= 200 && xhr.status < 300) {
                            formEl.closest('.offering-item').remove();
                            if (!list.querySelector('.offering-item')) {
                                list.style.display = 'none';
                            }
                            addWrap.hidden = false;
                            limitHint.style.display = 'none';
                        }
                    };
                    xhr.send();
                });
            }

            function addItem(offering) {
                var div = document.createElement('div');
                div.className = 'offering-item';
                div.style.position = 'relative';
                div.style.padding = '0.8rem 2.2rem 0.8rem 0';
                div.style.borderBottom = '1px solid var(--border)';
                var priceHtml = offering.price ? ' <span style="font-weight:normal; color:var(--muted);">– ' + escapeHtml(offering.price) + '</span>' : '';
                var descHtml = offering.description ? '<div style="color:var(--muted); font-size:0.9rem; margin-top:0.2rem;">' + escapeHtml(offering.description) + '</div>' : '';
                div.innerHTML =
                    '<div style="font-weight:600;">' + escapeHtml(offering.title) + priceHtml + '</div>' +
                    descHtml +
                    '<form method="post" action="/card/offerings/' + offering.id + '/delete" class="offering-delete-form" data-offering-id="' + offering.id + '" style="margin:0;">' +
                    '<button type="submit" style="position:absolute; top:0.7rem; right:0; margin:0; padding:0.2rem 0.55rem; font-size:0.75rem; background:var(--danger);">✕</button>' +
                    '</form>';
                list.appendChild(div);
                list.style.display = 'block';
                bindDeleteForm(div.querySelector('.offering-delete-form'));
            }

            list.querySelectorAll('.offering-delete-form').forEach(bindDeleteForm);

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (!titleInput.value.trim()) return;

                errorEl.style.display = 'none';
                addBtn.disabled = true;

                var formData = new FormData();
                formData.append('title', titleInput.value);
                formData.append('description', descriptionInput.value);
                formData.append('price', priceInput.value);

                var xhr = new XMLHttpRequest();
                xhr.open('POST', form.getAttribute('action'));
                xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');

                xhr.onload = function () {
                    addBtn.disabled = false;

                    var data = null;
                    try {
                        data = JSON.parse(xhr.responseText);
                    } catch (err) {
                        data = null;
                    }

                    if (data && data.success && data.offering) {
                        addItem(data.offering);
                        form.reset();
                        if (data.remaining <= 0) {
                            addWrap.hidden = true;
                            limitHint.style.display = 'block';
                        }
                    } else {
                        showError(data ? data.error : null);
                    }
                };

                xhr.onerror = function () {
                    addBtn.disabled = false;
                    showError(null);
                };

                xhr.send(formData);
            });
        })();
    </script>
{% endblock %}
